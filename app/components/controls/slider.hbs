<Controls::NumberBox
  class="slider-number center"
  @value={{@value}}
  @min={{@min}}
  @onChange={{@onChange}}
/>

<div
  class='grow-1 mh3 center'
  {{nexus-ui
    'Slider'
    min=@min
    max=@max
    value=@value
    onChange=@onChange
    step=@stepSize
    size=(array 20 140)
  }}
></div>


