<div class='flex flex-column h-100'>
  {{#if (gt @track.sourceNodeRecords.length 1)}}
    <Source::NodeTabs
      class="ml3"
      @yellow="true"
      @nodes={{@track.sourceNodeRecords}}
      @onSelect={{fn this.setUi 'targetNodeIdx'}}
      @selectedValue={{this.targetNodeIdx}}
    />
  {{/if}}

  <div class='flex flex-wrap justify-between drum-file-picker ph2 ph3-ns'>
    {{yield}}
    <Input
      aria-label='Search for Drum Sounds'
      class='ba bw1 b--yellow grow-1 light-gray bg-transparent f5 pa3'
      placeholder='Search for drums sounds'
      @value={{this.searchQuery}}
      {{on 'keyup' this.search}} 
    />
    {{#if this.searchResults.length}}
      <ButtonPrimary class="f6" {{on 'click' this.backToBrowse}} @label='← browse' />
    {{/if}}
  </div>

  <ProgressBar class={{concat 'fixed top-0 mv1 mh3 ' (unless this.searchTask.isRunning 'hidden')}} />

  {{#if this.searchResults.length}}
    <div
      class='flex justify-between flex-column mv3 overflow-scroll sidebar-inner-max-height'
    >
      <ul
        class='flex flex-column shrink-1 grow-1 list ma0 ph3'
      >
        {{#each this.searchResults as |result|}}
          <FileSearchResultDirectory
            @filePathRelative={{this.selectedNode.filepathControl.controlValue}}
            @result={{result}}
            @onSelect={{this.onSelectSearchResult}}
          />
        {{/each}}
      </ul>
      <SearchPagination
        class='pv2 grow-1'
        @currentPage={{this.currentPage}}
        @lastPage={{this.lastPage}}
        @search={{fn this.search this.searchQuery}}
      />
    </div>
  {{else}}
    <div class='flex overflow-x-scroll w-100 pv0 ph2 ph3-ns sidebar-inner-max-height'>
      {{#each @audioFileTree.directoryTree as |directory idx|}}
        <div class='flex w-auto flex-column mr2 min-w-5 grow-1'>
          <h4 class='dark-gray mt0 w-100 pv3 mb0 pl2 yellow bg-semi-transparent-dark-gray'>
            {{if (eq directory.type 'audio') 'Sounds' 'Drum Machine'}}
          </h4>
          <FileDirectory
            class='overflow-y-scroll h-100'
            @onSelectItem={{this.onSelectItem}}
            @directory={{directory}}
            @filepath={{@track.filepath}}
            @idx={{idx}}
          />
        </div>
      {{/each}}
    </div>
  {{/if}}
</div>
