{{!-- <Oscilloscope
  @id={{concat @track.id 'scope'}}
  @node={{@track.nodeToVisualize}}
  @fill='#ffce55'
  @accent='#000000'
/> --}}
<div class='flex justify-between w-auto grow-1'>
  <div class='flex w-auto mh1 flex-column'>
    <Console::Header>Source</Console::Header>

      {{!-- REFACTOR/REDESIGN: 
        this UI should represent filepath controls, sound-files and sampler track nodes

        Sample Pool: downloaded sound-files
        Buffer Waveforms: Sampler Nodes that are loaded with a waveform
        filepath-controls: UI connecting file selection to the wave form

      --}}
      {{!-- {{#each @track.sourceNodeRecords as |source|}}
        {{source.nodeType}}
        {{#if @track.samplerFilepathControl.filename}}
          -
          {{@track.samplerFilepathControl.filename}}
        {{/if}}
      {{/each}} --}}

      <Source::NodeTabs
        @nodes={{@track.sourceNodeRecords}}
        @onSelect={{fn this.setUi 'visibleNodeIdx'}}
        @selectedValue={{this.visibleNodeIdx}}
      />

    {{#if @showReference}}
      {{yield}}
    {{else}}
      {{#if @track.sourceNodeRecords.length}}
      
        {{#each @track.samplerNodes as |samplerNode|}}
          <ul class='flex items-center mv0 pa0 list f7'>
            {{#each samplerNode.filepathControl.pathSegments as |directory|}}
              {{#if directory.length}}
                <li class='directory-btns'>
                  <button
                    class='textbutton pa2'
                    type='button'
                    {{on 'click' @showFilePath}}
                  >
                    {{directory}}
                  </button>
                </li>
              {{/if}}
            {{/each}}
          </ul>
        {{/each}}
        
        {{!-- FIXME: move error to the node itself, not the track --}}
        {{!-- {{#if @track.fileDownloadError}}
          <div class="red bg-dark-gray pa3">
            <p>Error Downloading {{@track.samplerFilepathControl.pathSegments.lastObject}}</p>
            <p>{{@track.fileDownloadError}}</p>
          </div>
        {{/if}} --}}
      {{else}}
        <p class="light-gray bg-dark-gray pa3 mv0">There are no source nodes defined on this track</p>
      {{/if}}
      <div class="flex flex-column">
        {{#each @track.samplerNativeBuffers as |buffer idx|}}
          {{#if (and (eq idx this.visibleNodeIdx) buffer)}}
            <canvas
              class='ba bw1 w6 h-50 pointer-none'
              {{audio-waveform buffer}}
            ></canvas>
            <span class='ml1'>{{display-float buffer.duration}} sec</span>
          {{/if}}
        {{/each}}
      </div>
    {{/if}}
  </div>
</div>