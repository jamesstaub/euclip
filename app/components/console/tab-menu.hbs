<div
  class='tab-menu pv1 bw1 b--dark-gray relative flex f7 tc flex-wrap
    {{if @vertical "flex-column h-100 justify-around"}}'
  {{did-update this.setSelected @selectedValue}}
  ...attributes
>

  {{#each @items key='order' as |item|}}
    {{#if @vertical}}
      <button
        type='button'
        class='tab-btn vertical flex flex-column items-center ba b--dark-gray bw1 h-auto grow-1
          {{if
            (eq this.val item.value)
            "bg-light-blue black"
            "bg-yellow black"
          }}'
        {{on 'click' (fn this.select item.value)}}
        title={{item.label}}
      >
        <div class='flex items-center justify-center flex-column h-100 mb3'>
          {{svg-jar item.icon width=item.iconWidth height=item.iconHeight}}
          <p class='f6 mv0'>{{item.label}}</p>
        </div>
      </button>
    {{else}}
      <button
        type='button'
        class='tab-btn horizontal w4 f6 ttu
          {{if
            (eq this.val item.value)
            (concat "selected" " " @selectedClass)
            (concat " " @buttonClass)
          }}
          '

        title={{item.label}}
        {{on 'click' (fn this.select item.value)}}
      >
        {{item.label}}
        {{#if item.beacon}}
          <span class='absolute beacon right-1' title={{item.beacon}}>⬤</span>
        {{/if}}
      </button>
    {{/if}}
  {{/each}}
  {{yield}}
</div>