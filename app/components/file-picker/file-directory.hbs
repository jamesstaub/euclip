<div class='relative bg-semi-transparent-dark-gray directory-height' ...attributes>
  <ul class='list ph0 mt0 mr0 h-100'>
    {{#each this.filesWithSelectionInfo as |fileInfo|}}
      <ListItem @scrollBehavior={{this.scrollBehavior}} @selected={{eq @directory.currentDirIdx fileInfo.idx}}>
        <div class="flex items-center w-100">
          {{#if (and @showCheckboxes (eq @directory.type 'audio') @onToggleFileSelection)}}
            <label class="flex items-center mr2 {{fileInfo.labelClass}}" {{on "click" (fn this.preventPropagation)}}>
              <Input
                @type="checkbox" 
                @checked={{fileInfo.isSelected}}
                disabled={{fileInfo.isDisabled}}
                {{on "input" (fn this.toggleFileSelection fileInfo.filepath)}}
                class="mr2"
              />
            </label>
          {{/if}}
          
          <ListItemLink {{on 'click' (fn this.selectItem @directory fileInfo.choice)}} class="flex-grow-1">
            {{#if (eq @directory.type 'audio')}}
              {{filename-ui fileInfo.choice}}
            {{else}}
              {{fileInfo.choice}}
            {{/if}}
          </ListItemLink>
        </div>
      </ListItem>
    {{/each}}
  </ul>
</div>