<div ...attributes>
  <div class="flex flex-column">
    <label class="flex items-center mb2 pointer">
      <input 
        type="radio" 
        name="audio-mode" 
        value="current_track"
        checked={{eq @audioSelectMode "current_track"}}
        {{on "change" (fn @setAudioSelectMode "current_track")}}
        class="mr2"
      />
      <span class="f6">Add to current track</span>
    </label>
    <label class="flex items-center pointer">
      <input 
        type="radio" 
        name="audio-mode" 
        value="create_tracks"
        checked={{eq @audioSelectMode "create_tracks"}}
        {{on "change" (fn @setAudioSelectMode "create_tracks")}}
        class="mr2"
      />
      <span class="f6">Create multiple tracks</span>
    </label>
  </div>
</div>