
  <NavBar @logoWidth='180px'>
    {{#if this.session.isAuthenticated}}
      <DropdownMenu
        class='pv2 bg-transparent bn'
        @closeOnSelect={{true}}
        @items={{array (hash label='logout' select=(action 'invalidateSession'))}}
      >
        <img
          class='h2 w2 br-100'
          src={{this.currentUser.user.userAuth.avatarUrl}}
          alt={{this.currentUser.user.username}}
          title={{this.currentUser.user.username}}
        />
      </DropdownMenu>
    {{else}}
      <LinkTo class='yellow' @route='login'>login</LinkTo>
    {{/if}}
  </NavBar>

{{outlet}}