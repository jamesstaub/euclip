
  <NavBar @logoWidth='180px'>
    {{#if this.session.isAuthenticated}}
      <DropdownMenu
        class='pv2 bg-transparent bn'
        @closeOnSelect={{true}}
        @items={{array (hash label='logout' select=(action 'invalidateSession'))}}
      >
        <div class='h2 w2 br-100 bg-yellow flex items-center justify-center'>
          <span class='f3 dark-gray'>{{this.currentUser.user.username.[0]}}</span>
        </div>
      </DropdownMenu>
    {{else}}
      <LinkTo class='yellow' @route='login'>login</LinkTo>
    {{/if}}
  </NavBar>

{{outlet}}