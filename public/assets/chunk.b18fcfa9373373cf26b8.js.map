import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<Page::Wrapper>\n  <h1 class=\"tc\">Sorry, something went wrong while trying to create a new project.</h1>\n  <div class=\"mv3\">\n    {{#each this.model.errors as |err|}}\n      <p>{{render-model-error err}}</p>\n    {{/each}}\n  </div>\n</Page::Wrapper>\n",{ moduleName: "euclip/templates/user/new-error.hbs" })