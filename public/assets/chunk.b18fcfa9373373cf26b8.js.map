import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("\n  <NavBar @logoWidth=\"220px\" />\n  <Page::Wrapper>\n    <Auth::Form\n      @fieldsetId=\"log_in\"\n      @legend=\"Log In\"\n      @buttonLabel=\"Log In\"\n      @loadingLabel=\"Logging in...\"\n      @isLoading={{this.isSubmitting}}\n      @onSubmit={{this.submitAuth}}\n      @errorMessage={{this.errorMessage}}\n    >\n      <:inputs>\n      <Auth::Input\n        @id=\"username\"\n        @name=\"username\"\n        @label=\"Username\"\n        @placeholder=\"Enter Username\"\n        @autocomplete=\"username\"\n        @value={{this.username}}\n        @required={{true}}\n      />\n      <Auth::Input\n        @id=\"password\"\n        @name=\"password\"\n        @label=\"Password\"\n        @placeholder=\"Enter Password\"\n        @type=\"password\"\n        @autocomplete=\"current-password\"\n        @value={{this.password}}\n        @required={{true}}\n      />\n      </:inputs>\n      <:footer>\n        <div class=\'lh-copy mt3\'>\n          <LinkTo class=\'f6 tc link dark-gray underline db\' @route=\'signup\'>\n            Create Account\n          </LinkTo>\n        </div>\n      </:footer>\n    </Auth::Form>\n  </Page::Wrapper>\n  {{outlet}}\n\n",{ moduleName: "euclip/templates/login.hbs" })