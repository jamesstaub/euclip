import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex grow-1\'>\n  <div class=\'flex justify-between grow-1\'>\n    <div class=\'sequence-control-sliders flex flex-column mh2 w-100\'>\n      <Console::Header>Euclidean Rhythm</Console::Header>\n      {{#if @showReference}}\n        {{yield}}\n      {{else}}\n        <Sequence::Slider\n          @label=\"hits\"\n          @value={{@sequence.hits}}\n          @min={{0}}\n          @max={{@sequence.steps}}\n          @onChange={{fn @updateTrackSequence @sequence \'hits\'}}\n        />\n        <Sequence::Slider\n          @label=\"steps\"\n          @value={{@sequence.steps}}\n          @min={{0}}\n          @max={{@maxSteps}}\n          @onChange={{fn @updateTrackSequence @sequence \'steps\'}}\n        />\n        <Sequence::Slider\n          @label=\"offset\"\n          @value={{@sequence.offset}}\n          @min={{0}}\n          @max={{@maxSteps}}\n          @onChange={{fn @updateTrackSequence @sequence \'offset\'}}\n        />\n      {{/if}}\n    </div>\n  </div>\n</div>",{ moduleName: "euclip/components/sequence-container.hbs" })