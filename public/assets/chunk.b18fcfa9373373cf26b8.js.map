import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<Controls::NumberBox\n  class=\"slider-number center\"\n  @value={{@value}}\n  @min={{@min}}\n  @onChange={{@onChange}}\n/>\n\n<div\n  class=\'grow-1 mh3 center\'\n  {{nexus-ui\n    \'Slider\'\n    min=@min\n    max=@max\n    value=@value\n    onChange=@onChange\n    step=@stepSize\n    size=(array 20 140)\n  }}\n></div>\n\n\n{{!-- show on tippy --}}\n{{!-- <span class=\"f7 dark-gray truncate w3\">{{@transformedValue}}</span> --}}\n",{ moduleName: "euclip/components/controls/slider.hbs" })