import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<ListItem \n  @scrollBehavior=\"smooth\"\n  @selected={{@selected}} \n  ...attributes\n>\n  <ListItemLink {{on \"click\" @onSelect}}>\n    {{@file.filename}}\n  </ListItemLink>\n\n</ListItem>\n",{ moduleName: "euclip/components/file-search-result.hbs" })