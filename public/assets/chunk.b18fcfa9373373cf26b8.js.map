import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div >\n\n  {{#each this.notifications.notifications as |notification idx|}}\n    {{!-- FIXME: without this log the toast doesnt render :-(  --}}\n    {{log notification}} \n    <div\n      role=\'alert\'\n      {{shortcut \"Escape\" (fn this.dismiss idx)}}\n      class=\'max-w-100 relative ph3 pv2 ba bw1 mb2 mw5\n        {{style-for-notification notification.type}}\'\n    >\n\n      <IconButton\n        aria-label=\'Dismiss Notification\'\n        class=\'dark-fill absolute top-0 right-0 bg-transparent light-fill bn z-2 pa2\'\n        @icon=\'fi-cancel\'\n        @iconWidth=\'12px\'\n        @iconHeight=\'12px\'\n        {{on \'click\' (fn this.dismiss idx)}}\n      />\n      <p>{{notification.message}}</p>\n\n      {{#if notification.action}}\n        {{! TODO }}\n      {{/if}}\n    </div>\n  {{/each}}\n</div>",{ moduleName: "euclip/components/toast.hbs" })