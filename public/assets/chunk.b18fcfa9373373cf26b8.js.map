import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex flex-column h-100\'>\n  {{#if (gt @track.sourceNodeRecords.length 1)}}\n    <Source::NodeTabs\n      class=\"ml3\"\n      @yellow=\"true\"\n      @nodes={{@track.sourceNodeRecords}}\n      @onSelect={{fn this.setUi \'targetNodeIdx\'}}\n      @selectedValue={{this.targetNodeIdx}}\n    />\n  {{/if}}\n\n  <div class=\'flex flex-wrap justify-between drum-file-picker ph2 ph3-ns\'>\n    {{yield}}\n    <Input\n      aria-label=\'Search for Drum Sounds\'\n      class=\'ba bw1 b--yellow grow-1 light-gray bg-transparent f5 pa3\'\n      placeholder=\'Search for drums sounds\'\n      @value={{this.searchQuery}}\n      {{on \'keyup\' this.search}} \n    />\n    {{#if this.searchResults.length}}\n      <ButtonPrimary class=\"f6\" {{on \'click\' this.backToBrowse}} @label=\'← browse\' />\n    {{/if}}\n  </div>\n\n  <ProgressBar class={{concat \'fixed top-0 mv1 mh3 \' (unless this.searchTask.isRunning \'hidden\')}} />\n\n  {{#if this.searchResults.length}}\n    <div\n      class=\'flex justify-between flex-column mv3 overflow-scroll sidebar-inner-max-height\'\n    >\n      <ul\n        class=\'flex flex-column shrink-1 grow-1 list ma0 ph3\'\n      >\n        {{#each this.searchResults as |result|}}\n          <FileSearchResultDirectory\n            @filePathRelative={{this.selectedNode.filepathControl.controlValue}}\n            @result={{result}}\n            @onSelect={{this.onSelectSearchResult}}\n          />\n        {{/each}}\n      </ul>\n      <SearchPagination\n        class=\'pv2 grow-1\'\n        @currentPage={{this.currentPage}}\n        @lastPage={{this.lastPage}}\n        @search={{fn this.search this.searchQuery}}\n      />\n    </div>\n  {{else}}\n    <div class=\'flex overflow-x-scroll w-100 pv0 ph2 ph3-ns sidebar-inner-max-height\'>\n      {{#each @audioFileTree.directoryTree as |directory idx|}}\n        <div class=\'flex w-auto flex-column mr2 min-w-5 grow-1\'>\n          <h4 class=\'dark-gray mt0 w-100 pv3 mb0 pl2 yellow bg-semi-transparent-dark-gray\'>\n            {{if (eq directory.type \'audio\') \'Sounds\' \'Drum Machine\'}}\n          </h4>\n          <FileDirectory\n            class=\'overflow-y-scroll h-100\'\n            @onSelectItem={{this.onSelectItem}}\n            @directory={{directory}}\n            @filepath={{@track.filepath}}\n            @idx={{idx}}\n          />\n        </div>\n      {{/each}}\n    </div>\n  {{/if}}\n</div>\n",{ moduleName: "euclip/components/drum-file-picker.hbs" })