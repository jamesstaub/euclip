import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{!-- \n  this template for the /track/:id route is rendered as the footer for the currently selected track\n --}} \n<TrackFooterContainer\n  @track={{@model}}\n  @toggleSidebar={{fn this.toggleSidebar @track.id}}\n  @rightSidebarOpen={{this.project.rightSidebarOpen}}\n  @leftSidebarOpen={{this.project.leftSidebarOpen}}\n/>\n\n{{outlet}}",{ moduleName: "euclip/templates/user/creator/project/track.hbs" })