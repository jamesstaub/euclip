import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{#if @onToggleFilePicker}}\n  <ButtonPrimary\n    class=\'ba w4 f7 bg-dark-gray truncate ma2 relative {{this.classNames}}\'\n    {{on \'click\' @onToggleFilePicker}}\n    @restyle={{true}}\n    @label={{this.label}}\n    ...attributes\n  >\n    {{if\n      @filename\n      @filename\n      \'Pick a Sound\'\n    }}\n    {{#if @fileError}}\n      <span class=\'absolute beacon right-1\' title={{@fileError}}>⬤</span>\n    {{/if}}\n  </ButtonPrimary>\n{{/if}}",{ moduleName: "euclip/components/source-select-button.hbs" })