import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{!-- template-lint-disable require-button-type --}}\n{{!-- setting type=\"button\" here doesn\'t work when type=\"submit\" passed from above--}}\n<button \n  class=\"pv2 ph3 ttu fw6 bw1 {{unless @restyle \"bg-dark-gray yellow ba b--yellow\"}}\"\n  title={{@label}}\n  ...attributes\n>\n  {{#if (has-block)}}\n    {{yield}}\n  {{else}}\n    {{@label}}\n  {{/if}}\n</button>",{ moduleName: "euclip/components/button-primary.hbs" })