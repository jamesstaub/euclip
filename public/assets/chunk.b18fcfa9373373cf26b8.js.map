import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{!-- <Oscilloscope\n  @id={{concat @track.id \'scope\'}}\n  @node={{@track.nodeToVisualize}}\n  @fill=\'#ffce55\'\n  @accent=\'#000000\'\n/> --}}\n<div class=\'flex justify-between w-auto grow-1\'>\n  <div class=\'flex w-auto mh1 flex-column\'>\n    <Console::Header>Source</Console::Header>\n\n      {{!-- REFACTOR/REDESIGN: \n        this UI should represent filepath controls, sound-files and sampler track nodes\n\n        Sample Pool: downloaded sound-files\n        Buffer Waveforms: Sampler Nodes that are loaded with a waveform\n        filepath-controls: UI connecting file selection to the wave form\n\n      --}}\n      {{!-- {{#each @track.sourceNodeRecords as |source|}}\n        {{source.nodeType}}\n        {{#if @track.samplerFilepathControl.filename}}\n          -\n          {{@track.samplerFilepathControl.filename}}\n        {{/if}}\n      {{/each}} --}}\n\n      <Source::NodeTabs\n        @nodes={{@track.sourceNodeRecords}}\n        @onSelect={{fn this.setUi \'visibleNodeIdx\'}}\n        @selectedValue={{this.visibleNodeIdx}}\n      />\n\n    {{#if @showReference}}\n      {{yield}}\n    {{else}}\n      {{#if @track.sourceNodeRecords.length}}\n      \n        {{#each @track.samplerNodes as |samplerNode|}}\n          <ul class=\'flex items-center mv0 pa0 list f7\'>\n            {{#each samplerNode.filepathControl.pathSegments as |directory|}}\n              {{#if directory.length}}\n                <li class=\'directory-btns\'>\n                  <button\n                    class=\'textbutton pa2\'\n                    type=\'button\'\n                    {{on \'click\' @showFilePath}}\n                  >\n                    {{directory}}\n                  </button>\n                </li>\n              {{/if}}\n            {{/each}}\n          </ul>\n        {{/each}}\n        \n        {{!-- FIXME: move error to the node itself, not the track --}}\n        {{!-- {{#if @track.fileDownloadError}}\n          <div class=\"red bg-dark-gray pa3\">\n            <p>Error Downloading {{@track.samplerFilepathControl.pathSegments.lastObject}}</p>\n            <p>{{@track.fileDownloadError}}</p>\n          </div>\n        {{/if}} --}}\n      {{else}}\n        <p class=\"light-gray bg-dark-gray pa3 mv0\">There are no source nodes defined on this track</p>\n      {{/if}}\n      <div class=\"flex flex-column\">\n        {{#each @track.samplerNativeBuffers as |buffer idx|}}\n          {{#if (and (eq idx this.visibleNodeIdx) buffer)}}\n            <canvas\n              class=\'ba bw1 w6 h-50 pointer-none\'\n              {{audio-waveform buffer}}\n            ></canvas>\n            <span class=\'ml1\'>{{display-float buffer.duration}} sec</span>\n          {{/if}}\n        {{/each}}\n      </div>\n    {{/if}}\n  </div>\n</div>",{ moduleName: "euclip/components/source/container.hbs" })