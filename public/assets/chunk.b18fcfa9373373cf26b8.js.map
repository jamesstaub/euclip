import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{page-title \"Sign up\"}}\n\n<NavBar @logoWidth=\"220px\" />\n<Page::Wrapper>\n\n      <Auth::Form\n        @fieldsetId=\"sign_up\"\n        @legend=\"Create Account\"\n        @buttonLabel=\"Sign Up\"\n        @loadingLabel=\"Signing up...\"\n        @isLoading={{this.isSubmitting}}\n        @onSubmit={{this.submitAuth}}\n        @errorMessage={{this.errorMessage}}\n      >\n\n      <:inputs>\n        <Auth::Input\n          @id=\"username\"\n          @name=\"username\"\n          @label=\"Username\"\n          @placeholder=\"Enter Username\"\n          @autocomplete=\"username\"\n          @value={{this.username}}\n          @required={{true}}\n        />\n        <Auth::Input\n          @id=\"email\"\n          @name=\"email\"\n          @label=\"Email\"\n          @placeholder=\"Enter Email\"\n          @autocomplete=\"email\"\n          @value={{this.email}}\n          @required={{true}}\n        />\n        <Auth::Input\n          @id=\"password\"\n          @name=\"password\"\n          @label=\"Password\"\n          @placeholder=\"Enter Password\"\n          @type=\"password\"\n          @autocomplete=\"current-password\"\n          @value={{this.password}}\n          @required={{true}}\n        />\n\n      </:inputs>\n      <:footer>\n        <div class=\'lh-copy mt3\'>\n          <LinkTo class=\'f6 tc link dark-gray underline db\' @route=\'login\'>\n            Log In\n          </LinkTo>\n        </div>\n      </:footer>\n  </Auth::Form>\n</Page::Wrapper>\n",{ moduleName: "euclip/templates/signup.hbs" })