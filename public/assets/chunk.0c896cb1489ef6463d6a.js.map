import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<SidebarWrapper class=\'bw2 br b--yellow left-0\' @direction=\'left\' @onCloseSidebar={{@onCloseSidebar}}>\n  <div class=\'relative flex mh3-ns mh2 yellow flex-column\'>\n    {{#if @createFromDirectory}}\n      <Console::Header class=\"light-gray\">Select A Direcory</Console::Header>\n    {{else}}\n      <Console::Header class=\"light-gray\">Track {{@activeTrack.order}} Drum Machines</Console::Header>\n    {{/if}}\n    <InfoBox class=\'absolute top-0 right-2\'>\n      <p class=\'f6 mb3 mt0\'>When you select a sound file from this menu the\n        sound\'s URL is available in the code as\n        <code>this.filepath</code>.\n      </p>\n      <p class=\'f6 mb3 mt0\'>You pass the sound\'s URL to a\n        <code>sampler</code>\n        node in the Setup script like so:\n      </p>\n      <p class=\'f6 mb3 mt0\'><code>__().sampler({path: this.filepath})</code></p>\n    </InfoBox>\n  </div>\n  {{#if (and @activeTrack @activeTrack.audioFileTree (not @createFromDirectory))}}\n    <div class=\'flex flex-column h-100\'>\n      {{#if (gt @activeTrack.sourceNodeRecords.length 1)}}\n        <Source::NodeTabs\n          class=\"ml3\"\n          @yellow=\"true\"\n          @nodes={{@activeTrack.sourceNodeRecords}}\n          @onSelect={{fn this.setUi \'targetNodeIdx\'}}\n          @selectedValue={{this.targetNodeIdx}}\n        />\n      {{/if}}\n      <FilePicker::Search \n        @onSelectFile={{this.saveFilepathControl}}\n        @filePathRelative={{this.selectedNode.filepathControl.controlValue}}\n        @audioFileTree={{@activeTrack.audioFileTree}}\n      >\n        <FilePicker::Selection @onSelectItem={{this.onSelectItem}} @directoryTree={{@activeTrack.audioFileTree.directoryTree}}  />\n      </FilePicker::Search>\n    </div>\n\n  {{/if}}\n\n  {{#if @createFromDirectory}}\n    <FilePicker::Multiple/>\n  {{/if}}\n</SidebarWrapper>",{ moduleName: "euclip/components/file-picker/drum-file-sidebar.hbs" })