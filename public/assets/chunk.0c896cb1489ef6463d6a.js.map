import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'relative bg-semi-transparent-dark-gray directory-height\' ...attributes>\n  <ul class=\'list ph0 mt0 mr0 h-100\'>\n    {{#each @directory.choices as |choice idx|}}\n      <ListItem @scrollBehavior={{this.scrollBehavior}} @selected={{eq @directory.currentDirIdx idx}}>\n        <ListItemLink {{on \'click\' (fn this.selectItem @directory choice)}}>\n          {{#if (eq @directory.type \'audio\')}}\n            {{filename-ui choice}}\n          {{else}}\n            {{choice}}\n          {{/if}}\n        </ListItemLink>\n      </ListItem>\n    {{/each}}\n  </ul>\n</div>",{ moduleName: "euclip/components/file-directory.hbs" })