import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{#unless @rightSidebarOpen}}\n  <ButtonPrimary\n    @restyle={{true}}\n    class=\'relative truncate ma2 f7 flex items-center bg-dark-gray\n      {{if\n        (and @isActive @rightSidebarOpen)\n        \"light-yellow-button\"\n        \"yellow-fill\"\n      }}\n      {{if @track.isMaster \"mr3\"}}\'\n    ...attributes\n    {{on \'click\' @onToggleScripts}}\n    @label=\'scripts\'\n  >\n    {{svg-jar \'fi-code\' width=\'40px\' height=\'20px\'}}\n    {{#if @track.scriptAlert}}\n      <span class=\'absolute beacon left-1 f5 pa2\' title={{@track.scriptAlert}}>⬤</span>\n    {{/if}}\n\n  </ButtonPrimary>\n{{/unless}}",{ moduleName: "euclip/components/show-script-btn.hbs" })