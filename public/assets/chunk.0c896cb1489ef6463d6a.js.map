import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<button\n  type=\"button\"\n  class=\"bn f5 ttu flex items-center gap-1\"\n  title={{@label}}\n  aria-label={{@label}}\n  ...attributes\n>\n  {{svg-jar\n    @icon\n    class=@iconClass\n    width=(or @iconWidth \"20px\")\n    height=(or @iconHeight \"20px\")\n    aria-hidden=\"true\"\n    focusable=\"false\"\n  }}\n\n  {{#if (has-block)}}\n    {{yield}}\n  {{else if @label}}\n    <span class=\"sr-only\">{{@label}}</span>\n  {{/if}}\n</button>\n",{ moduleName: "euclip/components/icon-button.hbs" })