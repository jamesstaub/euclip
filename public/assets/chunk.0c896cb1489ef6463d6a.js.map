import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'relative flex grow-1\' ...attributes {{shortcut \'Command+Shift+Enter\' (perform @scriptModel.runCode)}}>\n  <div\n    class=\'grow-1 max-w-100 script-max-height\'\n    {{codemirror\n      (add @scriptModel.id this.renderFlag)\n      @scriptModel.editorContent\n      this.updateEditorContent\n    }}\n  ></div>\n\n</div>\n<div class=\'flex flex-column\'>\n  <div class=\'flex justify-between grow-1 mb3\'>\n    <div>\n      {{#if (or this.functionIsLoaded @scriptModel.runCode.isRunning)}}\n        <p class=\'mt2 mb0 ba b--gray b f4 w4 gray pv2 ph3 ttc bw1\'>Loaded...</p>\n      {{else}}\n        <SidebarSubmitButton\n          class=\'mt3 f4 w4\'\n          title={{if\n            this.functionIsLoaded\n            \'This script is loaded and running\'\n            \'Click to load this script (Command+Shift+Enter)\'\n          }}\n          @disabled={{this.functionIsLoaded}}\n          {{on \'click\' (perform @scriptModel.runCode)}}          \n        >\n            Load\n        </SidebarSubmitButton>\n      {{/if}}\n      {{#if this.functionIsLoaded}}\n        {{!-- <ButtonPrimary\n          {{on \'click\' this.disableScript}}\n          class=\'dark-red b--dark-red bg-dark-gray mt3 f4\'\n          @restyle={{true}}\n          title=\'Disable this script. Nodes will be removed and disconnected from the sequencer.\'\n        >disable</ButtonPrimary> --}}\n      {{else}}\n        {{#if this.canRevert}}\n          <ButtonPrimary\n            class=\'dark-gray b--light-gray bg-light-gray mt3 f4\'\n            @restyle={{true}}\n            {{on \'click\' this.discardChanges}}\n            title=\'Revert editor to currently running code\'\n          >\n            Revert\n          </ButtonPrimary>\n        {{/if}}\n      {{/if}}\n    </div>\n    {{yield}}\n  </div>\n\n  <div class=\'flex\'>\n    {{#if @scriptModel.alert}}\n      <div class=\'bg-dark-red pa3 mv2 white w-100\'>\n        <p\n          data-track={{@scriptModel.track.order}}\n        >{{@scriptModel.alert}}</p>\n        <p class=\"f7\">see console for more</p>\n      </div>\n    {{/if}}\n\n    {{#if this.illegalTokens}}\n      <p class=\'flex items-center mv0 yellow\'>\n        Remove unsupported keywords:\n        {{this.illegalTokens}}\n      </p>\n    {{/if}}\n  </div>\n</div>",{ moduleName: "euclip/components/script-editor.hbs" })