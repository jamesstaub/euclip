import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<NavBar @logoWidth=\"220px\"/>\n<div>\n\n  <section class=\"pa3\">\n    <div class=\"mw6 center\">\n      <h1>about euclip </h1>\n      <section class=\"mb3\">\n        <p>EUCLIP is a hybrid live coding environment for electronic music.</p>\n        <p>Write your own code or use preset snippits to build signal chains and musical logic.</p>\n      </section>\n      <section class=\"mb3\">\n        <h4>Dynamic UI</h4>\n        <p>EUCLIP\'s interface is created from the musical code you write.</p>\n        <p>\n          Say you write some code to create this signal chain on one of your tracks.\n          <code>[sampler-->lowpass filter-->output]</code>\n        </p>\n        <p>EUCLIP will create sliders to control the different parameters of those audio nodes such as <code>speed</code> for the sampler, <code>frequency</code> and <code>Q</code> for the filter etc.</p>\n        <p>You can control those properties manually with the sliders, or write code to change them algorithmically.</p>\n      </section>\n\n      <section class=\"mb3\">\n        <h4>Writing Musical Code</h4>\n        <p>EUCLIP\'s audio engine is powered by the <a href=\"https://billorcutt.github.io/i_dropped_my_phone_the_screen_cracked/cracked.html\" target=\"_blank\" rel=\"noopener noreferrer\" >Cracked library</a>.</p>\n        <p>Cracked provides an ergonomic syntax for creating powerful audio signal chains</p>\n        <p>Euclip is track based...</p>\n        <p><code>__()</code> is global... setup scripts vs onstep scripts.</p>\n        <p>automatic selectors for modifying parameters</p>\n      </section>\n\n      <section class=\"mb3\">\n        <h4>Credits</h4>\n        <p>EUCLIP is built and maintained by James Staub using the following open source projects:</p>\n        <ul class=\"list pl0\">  \n          <li>Cracked: web audio library by Bill Orcutt</li>\n          <li>Nexus UI library for musically useful interface elements</li>\n          <li>Ember JS web framework putting it all together.</li>\n        </ul>\n\n        <p>Special thanks to Sophie Greenspan for the logo, icons and theme, and additional icons from <a href=\"https://www.flaticon.com/authors/pixel-perfect\" title=\"Pixel perfect\">Pixel Perfect</a></p>\n      </section>\n\n      <section class=\"mb3\">\n        <h4>Contact</h4>\n        <p>Reach out on <a href=\"https://twitter.com/euclip_app\">twitter</a></p>\n        <p>Report an issue on <a href=\"https://github.com/jamesstaub/euclip-octane/issues\">github</a></p>\n      </section>\n      {{outlet}}\n    </div>\n  </section>\n</div>",{ moduleName: "euclip/templates/about.hbs" })