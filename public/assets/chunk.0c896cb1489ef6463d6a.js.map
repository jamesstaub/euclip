import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex flex-column slider-control-width ph2 f7\'>\n  <label class=\'flex items-center justify-between tl f7\'>{{\'max\'}}\n    <Controls::NumberBox\n      @onChange={{(fn this.setControlProperty \'max\')}}\n      @value={{@trackControl.max}}\n    /></label>\n  <label\n    class=\'flex items-center justify-between tl f7\'\n  >{{\'min\'}}<Controls::NumberBox\n      @onChange={{(fn this.setControlProperty \'min\')}}\n      @value={{@trackControl.min}}\n    /></label>\n  <label\n    class=\'flex items-center justify-between tl f7\'\n  >{{\'step size\'}}<Controls::NumberBox\n      @onChange={{(fn this.setControlProperty \'stepSize\')}}\n      @value={{@trackControl.stepSize}}\n    /></label>\n  <label\n    class=\'flex items-center justify-between tl f7\'\n  >{{\'default\'}}<Controls::NumberBox\n      @onChange={{(fn this.setControlProperty \'defaultValue\')}}\n      @value={{@trackControl.defaultValue}}\n    /></label>\n\n  <LabeledToggle\n    @on=\'Hits Only\'\n    @off=\'All Steps\'\n    @value={{@trackControl.applyHitsOnly}}\n    @onChange={{fn this.setControlProperty \'applyHitsOnly\'}}\n  />\n</div>\n{{yield}}",{ moduleName: "euclip/components/controls/control-config.hbs" })