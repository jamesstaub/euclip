import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div\n  class=\'flex spaced-text ttu f7 fw3 channel-strip-w flex-column shrink-0 tc bg-yellow bl\'\n  ...attributes\n>\n  <div class=\'w-100 mb1 pa2 bg-dark-gray white\'>\n    <span class=\'fw7 w3 light-gray\'>channel strip</span>\n  </div>\n  <div class=\'flex items-center justify-between grow-1 flex-column pa2\'>\n    <div class=\'relative flex items-center flex-column\'>\n      <span class=\'fw7 w3 pb2\'>gain</span>\n      <div class=\'flex\'>\n        <div\n          {{nexus-ui\n            \'Slider\'\n            min=@channelStripGainControl.min\n            max=@channelStripGainControl.max\n            value=@channelStripGainControl.controlValue\n            onChange=(fn @updateValue @channelStripGainControl)\n            step=@channelStripGainControl.step\n            size=(array 20 160)\n          }}\n        >\n        </div>\n\n        {{#if @channelStripPannerControl.trackNode.nativeNode}}\n          <div\n            {{nexus-ui\n              \'Meter\'\n              class=\'pointer-none\'\n              size=(array 10 160)\n              node=@channelStripPannerControl.trackNode.nativeNode\n            }}\n          >\n          </div>\n        {{/if}}\n      </div>\n    </div>\n    <div class=\'flex items-center flex-column\'>\n      <span class=\'fw7 w3 pb2\'>pan</span>\n      <div\n        {{nexus-ui\n          \'Slider\'\n          min=@channelStripPannerControl.min\n          max=@channelStripPannerControl.max\n          value=@channelStripPannerControl.controlValue\n          onChange=(fn @updateValue @channelStripPannerControl)\n          step=@channelStripPannerControl.step\n          size=(array 80 20)\n        }}\n      >\n      </div>\n    </div>\n\n  </div>\n</div>",{ moduleName: "euclip/components/channel-strip.hbs" })