import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("\n<span\n  class=\'mh3\'\n  {{nexus-ui\n    \'Toggle\'\n    value=(int-to-bool @value)\n    onChange=@onChange\n    size=(or @size (array 40 80))\n  }}\n></span>\n",{ moduleName: "euclip/components/controls/toggle.hbs" })