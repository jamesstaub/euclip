import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<Controls::NumberBox\n  class=\"slider-number center\"\n  @value={{@value}}\n  @min={{@min}}\n  @onChange={{@onChange}}\n/>\n\n<div\n  class=\'mh3 center\'\n  {{nexus-ui\n    \'Slider\'\n    min=@min\n    max=@max\n    value=@value\n    onChange=@onChange\n    step=@stepSize\n    size=(array 20 110)\n  }}\n></div>\n\n{{#if (not (eq @value @transformedValue))}}\n  <span class=\"f7 dark-gray\">{{@transformedValue}}</span>\n{{/if}}",{ moduleName: "euclip/components/controls/slider.hbs" })