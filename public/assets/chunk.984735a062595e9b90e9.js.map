import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<BasicDropdown as |dd|>\n  <dd.Trigger ...attributes>\n    <span class=\'caret\'></span>\n    {{#if (has-block)}}\n      {{yield}}\n    {{else}}\n      {{svg-jar\n        (or @icon \'fi-dots\')\n        class=(or @iconClass \'dark-fill\')\n        width=\'16px\'\n        height=\'40px\'\n      }}\n    {{/if}}\n  </dd.Trigger>\n\n  <dd.Content class=\'\'>\n    <ul class=\"list pl0 ma0 bg-light-gray ba bw2 b--dark-gray\">\n      {{#each @items as |item|}}\n        <li>\n          <button\n            class=\'bg-transparent hover-underline bn w-100 ph3 pv2\'\n            type=\'button\'\n            title={{item.label}}\n            {{on \'click\' (fn this.onSelectItem item.select dd.actions.close)}}\n          >\n            {{item.label}}\n          </button>\n        </li>\n      {{/each}}\n    </ul>\n  </dd.Content>\n</BasicDropdown>",{ moduleName: "euclip/components/dropdown-menu.hbs" })