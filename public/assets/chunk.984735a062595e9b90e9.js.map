import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{page-title \'Oops, problem\'}}\n\n<div class=\'ma3 max-w-50 center tc\'>\n  {{#if (eq this.model.errors.firstObject.status \'401\')}}\n    <h1>\n      You do not have permission to open this project.\n    </h1>\n  {{else if (eq this.model.errors.firstObject.status \'404\')}}\n    <h1> Project Not Found </h1>\n  {{else}}\n    <h1>\n      Sorry, something went wrong while trying to load this project.\n    </h1>\n    <p>{{this.model.errors.firstObject.title}}</p>\n  {{/if}}\n\n</div>",{ moduleName: "euclip/templates/user/creator/project-error.hbs" })