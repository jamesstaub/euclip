import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div\n  class=\'tab-menu relative flex f7 tc flex-wrap\n    {{if @verticle \"verticle flex-column h-100\"}}\'\n  {{did-update this.setSelected @selectedValue}}\n  ...attributes\n>\n  {{#each @items key=\'order\' as |item|}}\n    {{#if @verticle}}\n      <button\n        type=\'button\'\n        class=\'flex flex-column items-center ba b--dark-gray br0 h-auto grow-1\n          {{if\n            (eq this.val item.value)\n            \"bg-light-blue black\"\n            \"bg-yellow black\"\n          }}\'\n        {{on \'click\' (fn this.select item.value)}}\n        title={{item.label}}\n      >\n        <div class=\'flex items-center justify-center flex-column h-100 mb3\'>\n          {{svg-jar item.icon width=item.iconWidth height=item.iconHeight}}\n          <p class=\'f6 mv0\'>{{item.label}}</p>\n        </div>\n      </button>\n    {{else}}\n      <button\n        type=\'button\'\n        class=\'tab-btn w4 pa2 f6 ttu \n          {{if\n            (eq this.val item.value)\n            (concat \"selected\" \" \" @selectedClass)\n            (concat \" \" @buttonClass)\n          }}\'\n        title={{item.label}}\n        {{on \'click\' (fn this.select item.value)}}\n      >\n        {{item.label}}\n        {{#if item.beacon}}\n          <span class=\'absolute beacon right-1\' title={{item.beacon}}>⬤</span>\n        {{/if}}\n      </button>\n    {{/if}}\n  {{/each}}\n</div>",{ moduleName: "euclip/components/tab-menu.hbs" })