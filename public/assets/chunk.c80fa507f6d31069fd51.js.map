import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex items-center mv3\'>\n  <h4 class=\'ma0 w-75 pl1 yellow underline\'>{{@result.folder}}</h4>\n  {{#if (gt @result.files.length this.limit)}}\n    <button\n      class=\'overflow-hidden bg-transparent pa0 bn right-1 mt2\'\n      type=\'button\'\n      {{on \'click\' this.toggleTruncated}}\n    >\n      {{svg-jar\n        \'fi-play\'\n        class=(concat \'light-fill \' (if this.truncated \'rotate-0\' \'rotate-90\'))\n        width=\'16px\'\n        height=\'20px\'\n      }}\n    </button>\n  {{/if}}\n</div>\n{{#each (if this.truncated this.truncatedFiles @result.files) as |file|}}\n  <FileSearchResult\n    @selected={{eq @track.filePathRelative file.path}}\n    @file={{file}}\n    @onSelect={{fn @onSelect file.path}}\n  />\n{{/each}}",{ moduleName: "euclip/components/file-search-result-directory.hbs" })