import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'node-docs\'>\n  <h4 class=\'mv1\'>{{this.currentNode.label}}</h4>\n  <table>\n    <tbody>\n      <tr>\n        <td>attribute</td>\n        <td>type</td>\n        <td>defaultValue</td>\n        <td>detail</td>\n      </tr>\n      {{#each this.currentNodeDocs as |doc|}}\n        <tr>\n          <td>{{doc.label}}</td>\n          <td>{{doc.type}}</td>\n          <td>{{doc.defaultValue}}</td>\n          <td>{{doc.detail}}</td>\n        </tr>\n      {{/each}}\n\n    </tbody>\n\n  </table>\n\n</div>",{ moduleName: "euclip/components/cracked-node-docs.hbs" })