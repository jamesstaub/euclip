import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<ul class=\"list ph0 mt0 mr3 h-100\">\n  {{#each @presetCollections as |coll|}}\n    <ListItem class=\"pv2\">\n      {{coll.title}}\n    </ListItem>\n    <ul class=\"pl0 list\">\n      {{#each coll.presets as |preset|}}\n        <ListItem\n          class=\"pl3\"\n          @selected={{eq preset.id this.selectedPreset.id}}\n        >\n          <ListItemLink {{on \"click\" (fn this.selectItem preset)}} >\n            {{preset.title}}\n          </ListItemLink>\n        </ListItem>\n      {{/each}}\n    </ul>\n  {{/each}}\n</ul>\n\n{{!-- TODO: dedupe these buttons from signal chain creator footer buttons --}}\n<div class=\"pv3\">\n\n  <SidebarSubmitButton\n    title=\"Select preset and apply to track\"\n    @disabled={{not this.canSubmit}}\n    {{on \"click\" this.applyPreset}}\n  >\n    Select Preset\n  </SidebarSubmitButton>\n  \n  <ButtonPrimary\n    class=\"light-gray b--light-gray bg-dark-gray\"\n    @restyle={{true}}\n    {{on \"click\" @closeMenu}}\n    title=\"Generate Init Code\"\n  >\n    Cancel\n  </ButtonPrimary>\n</div>",{ moduleName: "euclip/components/preset-menu.hbs" })