import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<form class=\"project-form flex items-end\" {{on \'submit\' this.save}}>\n  {{#if this.isEditing}}\n    <div>\n      <label class=\"flex f7 flex-column\">\n        {{@label}}\n        <Input\n          autofocus={{true}}\n          class=\"project-input f4\"\n          name={{@key}}\n          placeholder=\"Enter a Project Title\"\n          {{on \'keydown\' this.onKey}}\n          @value={{@value}}\n          aria-label=\"Project Title\"\n        />\n      </label>\n    </div>\n  {{else}}\n    <button\n      class=\"project-button bg-transparent bn\"\n      type=\"button\"\n      {{on \'click\' this.toggleEdit}}\n      aria-label=\"Edit Project\"\n    >\n      <p ...attributes>{{@value}}</p>\n    </button>\n  {{/if}}\n\n  {{#if this.isEditing}}\n    <div class=\"flex\">\n      <button\n        class=\"bg-transparent ml1 mb1 bn\"\n        type=\"button\"\n        {{on \'click\' this.save}}\n        aria-label=\"Save Changes\"\n      >✔</button>\n\n      <IconButton \n        class=\"bg-transparent ml1 mb1 bn\"\n        type=\"button\"\n        {{on \'click\' this.toggleEdit}}\n        aria-label=\"Cancel Editing\"\n        @icon=\"fi-cancel\" {{on \"click\" @onCloseSidebar}} \n      />\n    </div>\n  {{/if}}\n</form>\n",{ moduleName: "euclip/components/editable-text.hbs" })