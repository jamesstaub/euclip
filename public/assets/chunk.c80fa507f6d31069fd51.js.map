import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("\n  <NavBar @logoWidth=\'180px\'>\n    {{#if this.session.isAuthenticated}}\n      <DropdownMenu\n        class=\'pv2 bg-transparent bn\'\n        @closeOnSelect={{true}}\n        @items={{array (hash label=\'logout\' select=(action \'invalidateSession\'))}}\n      >\n        <img\n          class=\'h2 w2 br-100\'\n          src={{this.currentUser.user.userAuth.avatarUrl}}\n          alt={{this.currentUser.user.username}}\n          title={{this.currentUser.user.username}}\n        />\n      </DropdownMenu>\n    {{else}}\n      <LinkTo class=\'yellow\' @route=\'login\'>login</LinkTo>\n    {{/if}}\n  </NavBar>\n\n{{outlet}}",{ moduleName: "euclip/templates/user.hbs" })