import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<li\n  {{scroll-into-view @selected @scrollBehavior}}\n  class=\'pl1\n    {{if\n      @selected\n      \"bg-yellow dark-gray\"\n      \"yellow hover-bg-near-black\"\n    }}\'\n  ...attributes\n>\n  {{yield}}\n</li>",{ moduleName: "euclip/components/list-item.hbs" })