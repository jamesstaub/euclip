import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class={{concat \"z-2 flex shrink-1 basis-auto grow-1 gray-blue-radial-bg \" this.responsiveClass}} \n  ...attributes\n  {{shortcut \"Escape\" @onCloseSidebar global=true}}\n>\n  <div class=\"relative flex w-100 flex-column\">\n    <IconButton class=\"absolute top-0 right-0 bg-transparent light-fill bn z-2 pa3\" @icon=\"fi-cancel\" \n      {{on \"click\" @onCloseSidebar}} \n      title=\"Close Sidebar (ESC)\"\n    />\n    {{yield}}\n  </div>\n</div>",{ moduleName: "euclip/components/sidebar-wrapper.hbs" })