import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<ButtonPrimary\n  class=\"mr3 ba\n    {{if\n      @disabled\n      \"b--gray bg-dark-gray light-blue\"\n      \"b--light-blue bg-light-blue dark-gray\"\n    }}\"\n  @restyle={{true}}\n  disabled={{@disable}}\n  ...attributes\n>\n  {{yield}}\n</ButtonPrimary>",{ moduleName: "euclip/components/sidebar-submit-button.hbs" })