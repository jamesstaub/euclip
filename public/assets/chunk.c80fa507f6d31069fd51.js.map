import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<form class=\"measure center\" {{on \"submit\" @onSubmit}}>\n  <fieldset id={{@fieldsetId}} class=\"ba b--transparent ph0 mh0\">\n    <legend class=\"f4 fw4 ph0 mh0 center fw6 dark-gray\">{{@legend}}</legend>\n    {{yield to=\'inputs\'}}\n  </fieldset>\n  {{#if @errorMessage}}\n    <p class=\"red f7 mt2\">{{@errorMessage}}</p>\n  {{/if}}\n  <div class=\"mt3\">\n    <Auth::ButtonSubmit\n      @label={{@buttonLabel}}\n      @loadingLabel={{@loadingLabel}}\n      @isLoading={{@isLoading}}\n      @onClick={{@onSubmit}}\n    />\n  </div>\n</form>\n{{yield to=\'footer\'}}",{ moduleName: "euclip/components/auth/form.hbs" })