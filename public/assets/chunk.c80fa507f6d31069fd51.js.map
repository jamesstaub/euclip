import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<button \n  type=\"button\"\n  class=\"ttc bg-transparent bn\"\n  title={{@label}}\n  ...attributes\n>\n  {{#if (has-block)}}\n    {{yield}}\n  {{else}}\n    {{@label}}\n  {{/if}}\n</button>",{ moduleName: "euclip/components/button-text.hbs" })