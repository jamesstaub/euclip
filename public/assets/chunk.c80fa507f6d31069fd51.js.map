import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex justify-start flex-column f7\'>\n  <p>Apply value:</p>\n  <label class=\"flex fw7\">\n    <span>\n      {{if @value @on @off}}\n    </span>\n    <Controls::Toggle\n      @size={{array 40 15}}\n      @value={{@value}}\n      @onChange={{@onChange}}\n    />\n  </label>\n</div>",{ moduleName: "euclip/components/labeled-toggle.hbs" })