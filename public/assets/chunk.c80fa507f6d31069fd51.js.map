import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex flex-wrap justify-between drum-file-picker ph3 mt3\'>\n  {{yield}}\n  <Input\n    aria-label=\'Search for Drum Sounds\'\n    class=\'ba bw1 b--yellow grow-1 light-gray bg-transparent f5 pa3\'\n    placeholder=\'Search for drums sounds\'\n    @value={{this.searchQuery}}\n     {{on \'keyup\' this.search}} \n  />\n  {{#if this.searchResults.length}}\n    <ButtonPrimary class=\"bl0 mt3\" {{on \'click\' this.backToBrowse}} @label=\'← browse\' />\n  {{/if}}\n</div>\n{{#if this.searchTask.isRunning}}\n  <ProgressBar class=\'absolute top-0 ma3\' />\n{{/if}}\n\n{{#if this.searchResults.length}}\n  <div\n    class=\'flex justify-between flex-column mv3 overflow-scroll\'\n  >\n    <ul\n      class=\'flex flex-column shrink-1 grow-1 list ma0 ph3\'\n    >\n      {{#each this.searchResults as |result|}}\n        <FileSearchResultDirectory\n          @track={{@track}}\n          @result={{result}}\n          @onSelect={{this.onSelectSearchResult}}\n        />\n      {{/each}}\n    </ul>\n    <SearchPagination\n      class=\'pv2 grow-1\'\n      @currentPage={{this.currentPage}}\n      @lastPage={{this.lastPage}}\n      @search={{fn this.search this.searchQuery}}\n    />\n  </div>\n{{else}}\n  <div class=\'flex overflow-x-scroll w-100 pa3 sidebar-inner-max-height\'>\n    {{#each @audioFileTree.directoryTree as |directory idx|}}\n      <div class=\'flex w-auto flex-column mr2 min-w-5\'>\n        <h4 class=\'black w-100 pv3 mb0 pl2 yellow bg-semi-transparent-dark-gray\'>\n          {{if (eq directory.type \'audio\') \'Sounds\' \'Drum Machine\'}}\n        </h4>\n        <FileDirectory\n          class=\'overflow-scroll h-100\'\n          @onSelectItem={{this.onSelectItem}}\n          @directory={{directory}}\n          @filepath={{@track.filepath}}\n          @idx={{idx}}\n        />\n      </div>\n    {{/each}}\n  </div>\n{{/if}}\n",{ moduleName: "euclip/components/drum-file-picker.hbs" })