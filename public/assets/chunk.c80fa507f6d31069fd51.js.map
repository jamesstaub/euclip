import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\"multislider-width multislider-bg\">\n  {{#let @sequence.length as |len|}}\n    {{#let (mult len 32.2) as |width|}}\n      <div\n        {{nexus-ui-multislider\n          min=@min\n          max=@max\n          stepIndex=@stepIndex\n          numberOfSliders=len\n          values=@values\n          sequence=@sequence\n          step=@stepSize\n          size=(array width 140)\n          onChange=@onChange\n          smoothing=0\n          mode=\'bar\'\n        }}\n      >\n      </div>\n    {{/let}}\n  {{/let}}\n</div>\n\n<div>\n\n{{yield}}\n</div>\n{{!-- multislider controls:\n  apply on: every step, only steps with beat\n --}}",{ moduleName: "euclip/components/controls/multislider.hbs" })