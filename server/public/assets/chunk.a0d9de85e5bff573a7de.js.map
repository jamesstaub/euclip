import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex\'>\n  {{#if @model.isPlaying}}\n    <IconButton class=\'bg-transparent mh1\' @icon=\'fi-pause\' @label=\'pause\' {{on \'click\' @pause}} />\n  {{else}}\n    <IconButton class=\'bg-transparent mh1\' @icon=\'fi-play\' @label=\'play\' {{on \'click\' @play}} />\n  {{/if}}\n\n  <IconButton class=\'bg-transparent mh1\' @icon=\'fi-stop\' @label=\'stop\' {{on \'click\' @stop}} />\n  <div class=\'flex items-center ba b--dark-gray bw1 ml2\'>\n    <div {{nexus-ui \'Number\' min=1 max=500 value=@model.bpm onChange=(perform @updateProject \'bpm\') step=1 }}></div>\n    <div><span class=\'pr3 f7\'>bpm</span></div>\n  </div>\n</div>",{ moduleName: "euclip/components/project/ui/transport.hbs" })