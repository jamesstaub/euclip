import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'selector-docs\'>\n  <table>\n    <tbody>\n      <tr>\n        {{#if this.idSelector}}\n          <td>\n            <span class=\'code mv1 pa1 f7\'>{{this.idSelector.name}}</span>\n          </td>\n          <td>\n            <p>\n              id: selects single node.\n            </p>\n            <p>\n              <code>__(\"#my-id-string\").</code>\n            </p>\n            <p>\n              An ID should never get defined on more than one node.\n            </p>\n          </td>\n        {{/if}}\n      </tr>\n      <tr>\n        <td>\n          {{#each this.classSelectors as |s|}}\n            {{#if (eq s.type \'class\')}}\n              <span class=\'code db min-w-3 mv1 pa1 f7\'>{{s.name}}</span>\n            {{/if}}\n          {{/each}}\n        </td>\n        <td>\n          <p>\n            class: selects any nodes with this class.\n          </p>\n          <p>\n            <code>__(\".my-class-string\")</code>\n          </p>\n          <p>\n            Selects any node with this class. Useful for selecting nodes within\n            a track.\n          </p>\n        </td>\n      </tr>\n      <tr>\n        {{#if this.elementSelector}}\n          <td class=\'min-w-4\'>\n            <span\n              class=\'code db mv1 pa1 f7\'\n            >{{this.elementSelector.name}}</span>\n          </td>\n          <td>\n            <p>\n              Node name\n            </p>\n            <p>\n              <code>__(sampler).</code>\n            </p>\n            <p>\n              Selects any node of this type across all tracks.\n            </p>\n          </td>\n        {{/if}}\n      </tr>\n    </tbody>\n  </table>\n\n  <p></p>\n</div>",{ moduleName: "euclip/components/selectors-list.hbs" })