import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("\n  <Page::Wrapper>\n    <div class=\'mv3 ph3 mw6 center measure\'>\n      {{#if @model }}<h2>Your Projects</h2>{{/if}}\n      <ul class=\'list ph0\'>\n        {{#each @model as |project|}}\n          <li class=\'flex justify-between pv2\'>\n            <div class=\'flex items-center grow-1\'>\n              {{#if project.isPlaying}}\n                <IconButton\n                  class=\'bg-transparent\'\n                  @icon=\'fi-stop\'\n                  @label=\'stop\'\n                  {{on \'click\' (fn this.stop project)}}\n                />\n              {{else}}\n                <IconButton\n                  class=\'bg-transparent\'\n                  @icon=\'fi-play\'\n                  @label=\'play\'\n                  {{on \'click\' (fn this.play project)}}\n                />\n              {{/if}}\n              <h3 class=\'mv0 ml3\'>\n                <LinkTo\n                  @route=\'user.creator.project\'\n                  @models={{array project.creator project.slug}}\n                  class=\'blue\'\n                >\n                  {{project.displayTitle}}\n                </LinkTo>\n              </h3>\n            </div>\n            <DropdownMenu\n              class=\'flex-grow bg-transparent h-100 dark-fill bn\'\n              @closeOnSelect={{true}}\n              @items={{array\n                (hash label=\'delete\' select=(fn this.deleteProject project))\n              }}\n            />\n          </li>\n        {{/each}}\n      </ul>\n\n      {{#unless @model.length}}\n      <div class=\"ma2\">\n          <LinkTo class=\'f4 blue\' @route=\"user.new\">\n          Create a project\n        </LinkTo>\n      </div>\n      {{/unless}}\n      {{outlet}}\n    </div>\n    {{outlet}}\n  </Page::Wrapper>\n",{ moduleName: "euclip/templates/user/my-projects.hbs" })