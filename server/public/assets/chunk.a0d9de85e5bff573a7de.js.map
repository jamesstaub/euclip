import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\"light-fill\" ...attributes>\n  <button class=\"bg-transparent bn pa3\" type=\"button\" {{on \"click\" this.toggleInfo}}>\n    {{svg-jar \"fi-question\" width=\"20px\" height=\"20px\"}}\n  </button>\n</div>\n\n{{#if this.open}}\n  <p class=\"dark-gray bg-light-gray pa3 mb3 mt0\">\n    {{yield}}\n  </p>\n{{/if}}",{ moduleName: "euclip/components/info-box.hbs" })