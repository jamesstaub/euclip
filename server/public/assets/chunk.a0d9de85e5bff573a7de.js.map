import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{yield}}\n<div class=\"flex flex-wrap ph3\" ...attributes>\n  {{#each this.pageNumbers as |pageNum|}}\n    <PaginationButton {{on \"click\" (fn this.selectPage pageNum)}} @label={{pageNum}}/>\n  {{/each}}\n</div>",{ moduleName: "euclip/components/search-pagination.hbs" })