import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'relative bg-semi-transparent-dark-gray directory-height\' ...attributes>\n  <ul class=\'list ph0 mt0 mr0 h-100\'>\n    {{#each this.filesWithSelectionInfo as |fileInfo|}}\n      <ListItem @scrollBehavior={{this.scrollBehavior}} @selected={{eq @directory.currentDirIdx fileInfo.idx}}>\n        <div class=\"flex items-center w-100\">\n          {{#if (and @showCheckboxes (eq @directory.type \'audio\') @onToggleFileSelection)}}\n            <label class=\"flex items-center mr2 {{fileInfo.labelClass}}\" {{on \"click\" (fn this.preventPropagation)}}>\n              <Input\n                @type=\"checkbox\" \n                @checked={{fileInfo.isSelected}}\n                disabled={{fileInfo.isDisabled}}\n                {{on \"input\" (fn this.toggleFileSelection fileInfo.filepath)}}\n                class=\"mr2\"\n              />\n            </label>\n          {{/if}}\n          \n          <ListItemLink {{on \'click\' (fn this.selectItem @directory fileInfo.choice)}} class=\"flex-grow-1\">\n            {{#if (eq @directory.type \'audio\')}}\n              {{filename-ui fileInfo.choice}}\n            {{else}}\n              {{fileInfo.choice}}\n            {{/if}}\n          </ListItemLink>\n        </div>\n      </ListItem>\n    {{/each}}\n  </ul>\n</div>",{ moduleName: "euclip/components/file-picker/file-directory.hbs" })