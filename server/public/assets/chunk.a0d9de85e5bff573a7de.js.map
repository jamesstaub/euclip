import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div ...attributes>\n  <div class=\"flex flex-column\">\n    <label class=\"flex items-center mb2 pointer\">\n      <input \n        type=\"radio\" \n        name=\"audio-mode\" \n        value=\"current_track\"\n        checked={{eq @audioSelectMode \"current_track\"}}\n        {{on \"change\" (fn @setAudioSelectMode \"current_track\")}}\n        class=\"mr2\"\n      />\n      <span class=\"f6 white\">Add to current track</span>\n    </label>\n    <label class=\"flex items-center pointer\">\n      <input \n        type=\"radio\" \n        name=\"audio-mode\" \n        value=\"create_tracks\"\n        checked={{eq @audioSelectMode \"create_tracks\"}}\n        {{on \"change\" (fn @setAudioSelectMode \"create_tracks\")}}\n        class=\"mr2\"\n      />\n      <span class=\"f6 white\">Create multiple tracks</span>\n    </label>\n  </div>\n</div>",{ moduleName: "euclip/components/file-picker/mode-selector.hbs" })