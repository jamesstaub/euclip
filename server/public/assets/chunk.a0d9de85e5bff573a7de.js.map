import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div\n  ...attributes\n  {{nexus-ui\n    \'Number\'\n    value=@value\n    min=(or @min -20000)\n    max=(or @max 20000)\n    step=(or @stepSize 0.0001)\n    onChange=@onChange\n    size=(array 60 30)\n  }}\n></div>",{ moduleName: "euclip/components/controls/number-box.hbs" })