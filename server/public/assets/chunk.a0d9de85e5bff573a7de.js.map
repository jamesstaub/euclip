import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\"flex pa2 justify-between flex-wrap\"> \n  <SequencePagination \n    @sequence={{@sequence}} \n    @stepIndex={{@stepIndex}}\n    @isCurrentTrack={{@isCurrentTrack}}\n    as |pgn|\n  >\n    <div class=\"sequencer-width flex justify-start shrink-0 mr3\">\n      {{#each pgn.sequencePaginated as |step idx|}}\n        <SequencerStep \n          {{on \"click\" (fn @onClickStep (add pgn.pageOffset idx))}}\n          @step={{step}} \n          @stepIndex={{seq-step-offset @stepIndex @sequence}} \n          @idx={{add idx pgn.currentPageStartIdx}}\n        />\n      {{/each}}\n    </div>\n  </SequencePagination>\n</div>",{ moduleName: "euclip/components/track-sequencer.hbs" })