import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex overflow-x-scroll w-100 pv0 ph2 ph3-ns sidebar-inner-max-height\'>\n  {{#each @directoryTree as |directory idx|}}\n    <div class=\'flex w-auto flex-column mr2 min-w-5 grow-1\'>\n      <h4 class=\'dark-gray mt0 w-100 pv3 mb0 pl2 yellow bg-semi-transparent-dark-gray\'>\n        {{if (eq directory.type \'audio\') \'Sounds\' \'Drum Machine\'}}\n      </h4>\n      <FilePicker::FileDirectory \n        class=\'overflow-y-scroll h-100\' \n        @onSelectItem={{@onSelectItem}} \n        @directory={{directory}}\n        @showCheckboxes={{@showCheckboxes}}\n        @selectedFiles={{@selectedFiles}}\n        @onToggleFileSelection={{@onToggleFileSelection}}\n        @canSelectMoreFiles={{@canSelectMoreFiles}}\n        @maxSelectableFiles={{@maxSelectableFiles}}\n        @filepath={{@track.filepath}} \n        @idx={{idx}} \n      />\n    </div>\n  {{/each}}\n</div>\n\n{{yield}}",{ moduleName: "euclip/components/file-picker/selection.hbs" })