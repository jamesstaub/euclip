import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex flex-wrap justify-between drum-file-picker ph2 ph3-ns\'>\n  <Input\n    aria-label=\'Search for Drum Sounds\'\n    class=\'ba bw1 b--yellow grow-1 light-gray bg-transparent f5 pa3\'\n    placeholder=\'Search for drums sounds\'\n    @value={{this.searchQuery}}\n    {{on \'keyup\' this.search}} \n  />\n  {{#if this.searchResults.length}}\n    <ButtonPrimary class=\"f6\" {{on \'click\' this.backToBrowse}} @label=\'← browse\' />\n  {{/if}}\n</div>\n\n<ProgressBar class={{concat \'fixed top-0 mv1 mh3 \' (unless this.searchTask.isRunning \'hidden\')}} />\n\n{{#if this.searchResults.length}}\n  <div\n    class=\'flex justify-between flex-column mv3 overflow-scroll sidebar-inner-max-height\'\n  >\n    <ul\n      class=\'flex flex-column shrink-1 grow-1 list ma0 ph3\'\n    >\n      {{#each this.searchResults as |result|}}\n        <FileSearchResultDirectory\n          @filePathRelative={{@filePathRelative}}\n          @result={{result}}\n          @onSelect={{this.onSelectSearchResult}}\n        />\n      {{/each}}\n    </ul>\n    <SearchPagination\n      class=\'pv2 grow-1\'\n      @currentPage={{this.currentPage}}\n      @lastPage={{this.lastPage}}\n      @search={{fn this.search this.searchQuery}}\n    />\n  </div>\n{{else}}\n  {{yield}}\n{{/if}}",{ moduleName: "euclip/components/file-picker/search.hbs" })