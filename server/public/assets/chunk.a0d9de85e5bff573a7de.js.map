import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class={{concat \"w-100\" (if this.showPages \"mv1\")}} {{did-update (fn this.autoPageOnUpdate @sequence @stepIndex @isCurrentTrack)}} ...attributes>\n  <div class=\"flex w-auto\">\n    {{#if this.showPages}}\n      {{#each this.paginationButtons as |pageIdx|}}\n        {{#if (add pageIdx 1)}}\n          <PaginationButton \n            {{on \"click\" (fn this.setPage pageIdx)}} @label={{add pageIdx 1}}\n            @selected={{eq pageIdx this.page}}\n            @highlight={{eq pageIdx this.pageForStepIndex}}\n          />\n        {{else}}\n          <PaginationButton disabled={{true}}/>\n        {{/if}}\n      {{/each}}\n    {{/if}}\n  </div>\n</div>\n{{yield this}}",{ moduleName: "euclip/components/sequence-pagination.hbs" })