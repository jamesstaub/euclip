import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<SidebarWrapper class=\'bw2 br b--yellow left-0\' @direction=\'left\' @onCloseSidebar={{@onCloseSidebar}}>\n  <div class=\'relative flex mh3-ns mh2 yellow flex-column\'>\n\n    {{#if this.isCurrentTrackMode}}\n      <Console::Header class=\"light-gray mb2\">Select Sampler For Track {{@activeTrack.order}}</Console::Header>\n    {{else}}\n      <Console::Header class=\"light-gray mb2\">Create Tracks From Selection</Console::Header>\n    {{/if}}\n    <InfoBox class=\'absolute top-0 right-2\'>\n      <p class=\'f6 mb3 mt0\'>When you select a sound file from this menu the\n        sound\'s URL is available in the code as\n        <code>this.filepath</code>.\n      </p>\n      <p class=\'f6 mb3 mt0\'>You pass the sound\'s URL to a\n        <code>sampler</code>\n        node in the Setup script like so:\n      </p>\n      <p class=\'f6 mb3 mt0\'><code>__().sampler({path: this.filepath})</code></p>\n    </InfoBox>\n  </div>\n  \n  \n  <div class=\'flex flex-column h-100\'>\n    {{#if (and this.isCurrentTrackMode (gt @activeTrack.sourceNodeRecords.length 1))}}\n      <Source::NodeTabs\n        class=\"ml3\"\n        @yellow=\"true\"\n        @nodes={{@activeTrack.sourceNodeRecords}}\n        @onSelect={{fn this.setUi \'targetNodeIdx\'}}\n        @selectedValue={{this.targetNodeIdx}}\n      />\n    {{/if}}\n    \n    <FilePicker::Search \n      @onSelectFile={{this.onSelectFileFromSearch}}\n      @filePathRelative={{if this.isCurrentTrackMode this.selectedNode.filepathControl.controlValue}}\n      @audioFileTree={{this.audioFileTreeForMode}}\n    >\n    \n      <FilePicker::ModeSelector\n        class=\"pa3\"\n        @activeTrack={{@activeTrack}} \n        @audioSelectMode={{@audioSelectMode}}\n        @setAudioSelectMode={{@setAudioSelectMode}}\n      />\n      <FilePicker::Selection \n        @onSelectItem={{this.onSelectItem}} \n        @directoryTree={{this.audioFileTreeForMode.directoryTree}}\n        @showCheckboxes={{this.isCreateTracksMode}}\n        @selectedFiles={{this.selectedFiles}}\n        @onToggleFileSelection={{this.toggleFileSelection}}\n      />\n      \n      {{#if (and this.isCreateTracksMode (gt this.selectedFiles.length 0))}}\n        <div class=\"absolute bottom-0 w-100 pa3 bt b--yellow bg-semi-transparent-dark-gray\">\n          <ButtonPrimary \n            @label={{concat \"Create \" this.selectedFiles.length \" track\" (if (gt this.selectedFiles.length 1) \"s\")}}\n            {{on \"click\" this.submitSelectedFiles}}\n            class=\"w-100\"\n          />\n        </div>\n      {{/if}}\n    </FilePicker::Search>\n  </div>\n</SidebarWrapper>",{ moduleName: "euclip/components/file-picker/drum-file-sidebar.hbs" })