import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<button\n  class=\'small-square flex justify-center items-center f7 ba dark-gray\n    {{if @selected \"bg-light-blue\" \"bg-light-gray\"}}\n    {{if @highlight \"b--dark-red bw2\" \"b--dark-gray\"}}\n    \'\n  title={{concat \'Page \' @label}}\n  ...attributes\n  type=\'button\'\n>\n  {{@label}}\n</button>",{ moduleName: "euclip/components/pagination-button.hbs" })