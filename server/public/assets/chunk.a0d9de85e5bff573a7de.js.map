import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<button\n  type=\"submit\"\n  class=\"b bw2 ph3 pv2 w-100 input-reset ba pointer f6 dib b--dark-gray bg-yellow dark-gray\"\n\n  disabled={{@isLoading}}\n  {{on \"click\" @onClick}}\n>\n  {{#if @isLoading}}\n    <span class=\"spinner mr2\"></span>\n    {{@loadingLabel}}\n  {{else}}\n    {{@label}}\n  {{/if}}\n</button>",{ moduleName: "euclip/components/auth/button-submit.hbs" })