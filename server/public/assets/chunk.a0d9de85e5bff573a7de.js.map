import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\'flex items-center ma3\'>\n  <span class=\"fw7 w3\">{{@label}}:</span>\n  <span class=\"fw7 w2 tr\">{{@value}}</span>\n  <div\n    class=\"mh3\"\n    {{nexus-ui\n      \'Slider\'\n      min=@min\n      max=@max\n      value=@value\n      step=1\n      size=(array 300 20)\n      onChange=@onChange\n    }}\n  ></div>\n</div>",{ moduleName: "euclip/components/sequence/slider.hbs" })