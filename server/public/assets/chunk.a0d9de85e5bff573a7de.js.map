import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{page-title this.model.title}}\n<Project::UiState @activeTrack={{this.activeTrack}} @project={{this.model}}>\n  <:content as |uiState|>\n    <div class=\"flex flex-column grow-1 shrink-0\">\n      <nav class=\'flex items-center justify-between ph3 pv2 bg-light-gray\'>\n        <div class=\'flex flex-wrap items-center justify-between w-100\'>\n          <EditableText \n            class=\'truncate ma0 f4 mw5\'\n            @label=\"Project Title\"\n            @value={{this.model.title}}\n            @onSave={{this.updateName}}\n            @onCancel={{this.revertName}}\n          />\n\n          <Project::Ui::Transport\n            @model={{this.model}}\n            @updateProject={{this.updateProject}}\n            @pause={{this.pause}}\n            @play={{this.play}}\n            @stop={{this.stop}}\n          />\n          <div class=\'flex ml3\'>\n            <ButtonPrimary @label={{\'New Track\'}} {{on \'click\' this.createTrack}} />\n            <DropdownMenu\n              class=\'h-100 grow-1 bg-dark-gray ba bl-0 bw1 b--yellow ph2\'\n              @icon=\'fi-play\'\n              @iconClass=\'yellow-fill rotate-90\'\n              @closeOnSelect={{true}}\n              {{!-- @items={{array\n                (hash label=\'Sampler\' select=(fn this.createTrack \'samplerPreset\'))\n                (hash label=\'Synth\' select=(fn this.createTrack \'synthPreset\'))\n                (hash label=\'New From Preset\')\n                (hash label=\'Drum Machine\' select=uiState.openCreateFromDirectory)\n                (hash label=\'Blank Track\' select=(fn this.createTrack \'signalChainGui\'))\n              }} --}}\n                            @items={{array\n                (hash label=\'Sampler\' select=(fn this.createTrack \'samplerPreset\'))\n                (hash label=\'Drum Machine\' select=uiState.openCreateFromDirectory)\n              }}\n            />\n          </div>\n        </div>\n      </nav>\n\n      <div\n        class=\'flex flex-wrap overflow-hidden grow-1 flex-nowrap-ns\'\n      >\n        {{#if\n          (or \n            uiState.createFromDirectory\n            (and uiState.leftSidebarOpen this.activeTrack (not this.activeTrack.isDeleted))\n          )\n        }}\n          <FilePicker::DrumFileSidebar\n            @project={{this.model}}\n            @activeTrack={{this.activeTrack}}\n            @onTracksCreated={{this.onTracksCreated}}\n            @defaultAudioFileTree={{this.defaultAudioFileTree}}\n            @audioSelectMode={{uiState.audioSelectMode}}\n            @setAudioSelectMode={{uiState.setAudioSelectMode}}\n            @onCloseSidebar={{fn uiState.closeSidebar \'left\'}}        \n          />\n        {{/if}}\n        <TrackListWrapper\n          @rightSidebarOpen={{uiState.rightSidebarOpen}}\n          @leftSidebarOpen={{uiState.leftSidebarOpen}}\n          {{shortcut \'ArrowUp\' this.selectPrevTrack}}\n          {{shortcut \'ArrowDown\' this.selectNextTrack}}\n        >\n          <div class=\'overflow-y-scroll bg-dark-gray track-list-height min-height-5 grow-1\'>\n            {{#each this.sortedTracks key=\'order\' as |track|}}\n              {{#unless track.isMaster}}\n                <TrackListItem\n                  @track={{track}}\n                  @isActive={{eq track.id this.activeTrack.id}}\n                  @selectActiveTrack={{fn this.transitionToTrack track.id}}\n                  @onToggleFilePicker={{fn uiState.toggleSidebar track.id \'left\'}}\n                  @onToggleScripts={{fn uiState.toggleSidebar track.id \'right\'}}\n                  @rightSidebarOpen={{uiState.rightSidebarOpen}}\n                />\n              {{/unless}}\n            {{/each}}\n            {{#each this.sortedTracks as |track|}}\n              {{#if track.isMaster}}\n                <TrackListItem\n                  @track={{track}}\n                  @isActive={{eq track.id this.activeTrack.id}}\n                  @selectActiveTrack={{fn this.transitionToTrack track.id}}\n                  @onToggleScripts={{fn uiState.toggleSidebar track.id \'right\'}}\n                  @rightSidebarOpen={{uiState.rightSidebarOpen}}\n                />\n              {{/if}}\n            {{/each}}\n          </div>\n          {{outlet}}\n        </TrackListWrapper>\n        {{#if\n          (and\n            uiState.rightSidebarOpen this.activeTrack (not this.activeTrack.isDeleted)\n          )\n        }}\n          <SidebarWrapper\n            class={{concat \'bw2 bl b--yellow right-0\'}}\n            @direction=\'right\'\n            @onCloseSidebar={{fn uiState.closeSidebar \'right\'}}\n          >\n            <div class=\'relative flex mh3-ns mh2 yellow flex-column\'>\n              <Console::Header class=\"light-gray\">Track {{this.activeTrack.order}} Scripts</Console::Header>\n              <InfoBox class=\'absolute top-0 right-2\'>\n                <p class=\'f6 mb3 mt0\'>Scripts are where you define the audio signal\n                  chain for each track.</p>\n                <p class=\'f6 mb3 mt0\'><b class=\'ttu\'>Setup</b>\n                  script runs once to create your audio signal chain. Audio Nodes can\n                  be defined with a\n                  <code>class</code>\n                  or\n                  <code>ID</code>, which are used to select and modify their\n                  parameters.</p>\n                <p class=\'f6 mb3 mt0\'><b class=\'ttu\'>Play</b>\n                  script runs on every step of the sequencer. This is where you\n                  trigger sound and modulate parameters.<br />\n                  Select node IDs with:\n                  <code>__(\'#someID\')</code>\n                  <br />Select node classes with:\n                  <code>__(\'.someClass\')</code>\n                </p>\n                <p class=\'mv0\'><a\n                    class=\'blue fw6 ttu\'\n                    href=\'https://billorcutt.github.io/i_dropped_my_phone_the_screen_cracked/cracked.html\'\n                    target=\'_blank\'\n                    rel=\'noopener noreferrer\'\n                  >Read the Cracked docs</a></p>\n              </InfoBox>\n            </div>\n            <ScriptWrapper\n              @track={{this.activeTrack}}\n              @presetCollections={{this.presetCollections}}\n            />\n          </SidebarWrapper>\n        {{/if}}\n      </div>\n    </div>\n  </:content>\n</Project::UiState>",{ moduleName: "euclip/templates/user/creator/project.hbs" })