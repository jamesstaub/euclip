import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div class=\"auth-input-wrapper mv3 w-100\">\n  <label for={{@id}} class=\"db lh-copy f7 fw6 ttu dark-gray\">\n    {{@label}}\n  </label>\n  <Input\n    id={{@id}}\n    name={{@name}}\n    autocomplete={{@autocomplete}}\n    class=\"pa2 b--dark-gray ba bw1 input-reset ba w-100 border-box dark-gray bg-light-gray\"\n    @type={{@type}}\n    @value={{@value}}\n    aria-required={{if @required \"true\" \"false\"}}\n    aria-invalid={{if @isInvalid \"true\" \"false\"}}\n    \n  />\n  {{#if @errorMessage}}\n    <p class=\"red f7 mt1\">{{@errorMessage}}</p>\n  {{/if}}\n</div>",{ moduleName: "euclip/components/auth/input.hbs" })