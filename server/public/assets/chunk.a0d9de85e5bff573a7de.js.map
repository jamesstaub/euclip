import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<Console::TabMenu\n  class=\'nodes-wrapper mb2 flush flex-nowrap max-w-100 overflow-x-scroll overflow-y-hidden grow-0 shrink-0\'\n  @selectedClass={{concat \'bn br4 mr2 \' (if @yellow \'bg-yellow\' \'bg-dark-gray light-gray\')}}\n  @buttonClass={{concat \'ba br4 bw1 mr2 bg-transparent \' (if @yellow \'b--yellow yellow\' \'b--dark-gray dark-gray\')}}\n  @onSelect={{@onSelect}} \n  @items={{this.nodeTabs}} \n  @selectedValue={{@selectedValue}} \n  ...attributes\n/>",{ moduleName: "euclip/components/source/node-tabs.hbs" })