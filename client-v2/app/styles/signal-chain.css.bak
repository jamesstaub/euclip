/*
 * The signal chain pane: rows of boxes joined by lines. A row scrolls sideways inside the pane when it
 * is long; the page never does. Nothing changes size when a node is chosen (its state is its fill and
 * an outline, which take no room).
 */

.signal-chain {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-inline-size: 0;
}

.signal-chain__status {
  margin: 0;
  padding: var(--space-1) var(--space-2);
  border: var(--border-dark);
  background: var(--near-black);
  color: var(--text-on-dark);
  font-size: var(--font-size-6);
}

.chain-row {
  min-inline-size: 0;
}

.chain-row__title {
  margin: 0 0 var(--space-1);
  font-size: var(--font-size-7);
  font-weight: var(--font-weight-heavy);
  letter-spacing: var(--letter-spacing-spaced);
  text-transform: uppercase;
}

.chain-row__line {
  display: flex;
  align-items: stretch;
  margin: 0;
  padding: var(--space-1) 0 var(--space-2);
  overflow-x: auto;
  list-style: none;
}

.chain-link {
  display: flex;
  flex: none;
  align-items: center;
}

.chain-link--end {
  padding-inline-end: var(--space-2);
}

.chain-node {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-inline-size: 5rem;
  min-block-size: max(3rem, var(--target-min));
  padding: var(--space-1) var(--space-2);
  border: var(--border-dark);
  background: var(--near-white);
  color: var(--text-on-light);
  font-size: var(--font-size-6);
  text-align: start;

  & b {
    font-weight: var(--font-weight-heavy);
    letter-spacing: var(--letter-spacing-spaced);
    text-transform: uppercase;
  }

  & span {
    font-family: var(--font-mono);
    font-size: var(--font-size-7);
  }

  /* the chosen node gets an outline as well as its fill, which take no room */
  &[aria-pressed="true"] {
    background: var(--light-blue);
    outline: var(--border-width-3) solid var(--dark-blue);
    outline-offset: calc(-1 * var(--border-width-3));
  }

  &:disabled {
    cursor: default;
  }
}

/* an audio line: solid, with an arrow head */
.chain-wire {
  position: relative;
  flex: none;
  inline-size: 1.5rem;
  block-size: 0;
  border-block-start: var(--border-width-2) solid var(--dark-gray);

  &::after {
    content: "";
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(-0.3125rem - var(--border-width-1));
    border-block: 0.3125rem solid transparent;
    border-inline-start: 0.4375rem solid var(--dark-gray);
  }
}

/* a modulator's line: dashed, and it says what it does */
.chain-wire--modulates {
  inline-size: 4.5rem;
  border-block-start-style: dashed;

  & i {
    position: absolute;
    inset-block-end: 0.25rem;
    inset-inline: 0;
    font-size: 0.625rem;
    font-style: normal;
    text-align: center;
  }
}

.chain-dest {
  display: flex;
  align-items: center;
  min-block-size: max(3rem, var(--target-min));
  padding: var(--space-1) var(--space-2);
  border: var(--border-width-2) dashed var(--dark-gray);
  background: var(--dark-gray);
  color: var(--text-on-dark);
  font-family: var(--font-mono);
  font-size: var(--font-size-6);
  white-space: nowrap;

  &[data-kind="none"] {
    background: transparent;
    color: inherit;
  }

  &[data-kind="param"] {
    background: var(--near-white);
    color: var(--text-on-light);
  }
}

.chain-row[data-kind="modulator"] .chain-node {
  border-style: dashed;
}

/* a node made by code Euclip cannot edit from here: it says so, quietly */
.chain-node[data-readonly="true"] {
  border-style: dotted;

  & i {
    font-size: 0.625rem;
    font-style: normal;
    opacity: 0.75;
  }
}

/*
 * What can be done with the chosen node: a bar that is always there, with a fixed height, so choosing
 * a node (or being told why something cannot be done) moves nothing under it.
 */
.chain-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);

  /* it stays in view at the bottom of the pane while the rows scroll under it */
  position: sticky;
  inset-block-end: 0;
  z-index: 1;

  /* room for the buttons on two lines, and the reason; wide, they fit on one */
  min-block-size: 11.5rem;
  padding: var(--space-2);
  border: var(--border-dark);
  background: var(--light-yellow);
}

@container track-footer (min-width: 36rem) {
  .chain-actions {
    min-block-size: 8.5rem;
  }
}

.chain-actions__what {
  margin: 0;
  font-size: var(--font-size-6);

  & b {
    font-weight: var(--font-weight-heavy);
    letter-spacing: var(--letter-spacing-spaced);
    text-transform: uppercase;
  }

  & span {
    margin-inline-start: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--font-size-7);
  }
}

.chain-actions__buttons {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-1);

  & .btn {
    min-inline-size: 0;
    line-height: var(--line-height-solid);
    text-align: center;
    white-space: normal;
  }
}

@container track-footer (min-width: 36rem) {
  .chain-actions__buttons {
    display: flex;
    flex-wrap: wrap;
  }
}

.chain-actions__why {
  max-block-size: 3.5rem;
  margin: 0;
  overflow-y: auto;
  font-size: var(--font-size-7);
  line-height: var(--line-height-copy, 1.4);
}

/* the picker of node types */
.chain-picker {
  inline-size: min(28rem, calc(100vw - 2rem));
  max-block-size: min(32rem, calc(100dvh - 2rem));
  padding: var(--space-2);
  border: var(--border-dark);
  background: var(--yellow);
  color: var(--text-on-light);

  &::backdrop {
    background: var(--black-50);
  }

  &[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
}

.chain-picker__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.chain-picker__search {
  min-block-size: var(--target-min);
  padding: var(--space-1) var(--space-2);
  border: var(--border-dark);
  background: var(--near-white);
  color: var(--text-on-light);
}

.chain-picker__list {
  flex: 1 1 auto;
  min-block-size: 0;
  overflow-y: auto;

  & h4 {
    margin: var(--space-2) 0 var(--space-1);
    font-size: var(--font-size-7);
    font-weight: var(--font-weight-heavy);
    letter-spacing: var(--letter-spacing-spaced);
    text-transform: uppercase;
  }

  & ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
}

.chain-picker__type {
  min-block-size: var(--target-min);
  padding: var(--space-1) var(--space-2);
  border: var(--border-dark);
  background: var(--near-white);
  color: var(--text-on-light);
  font-size: var(--font-size-6);

  &:hover {
    background: var(--light-blue);
  }
}

.chain-picker__new {
  display: flex;
  gap: var(--space-1);
  margin-block-start: var(--space-2);
}

.chain-picker__new .chain-picker__search {
  flex: 1 1 auto;
  min-inline-size: 0;
}

.chain-picker__problem {
  min-block-size: 1.25rem;
  margin: var(--space-1) 0 0;
  font-size: var(--font-size-7);
}

.chain-picker__type[aria-pressed="true"] {
  background: var(--light-blue);
}

.chain-dest[aria-pressed="true"] {
  outline: var(--border-width-3) solid var(--light-blue);
  outline-offset: calc(-1 * var(--border-width-3));
}
