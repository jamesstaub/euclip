#!/usr/bin/env bash
# Run Rails (http://localhost:3000) and Ember (http://localhost:4200, proxies /v1 etc. to Rails).
set -uo pipefail
cd "$(dirname "$0")/.."
trap 'kill 0' EXIT INT TERM
(cd server && bundle exec rails server -p 3000 2>&1 | sed -u 's/^/[rails] /') &
(cd client && npx ember serve --proxy http://localhost:3000 2>&1 | sed -u 's/^/[ember] /') &
wait
