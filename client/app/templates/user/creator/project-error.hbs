{{page-title 'Oops, problem'}}

<div class='ma3 mw6 center tc' role='alert'>
  {{#if (eq this.firstError.status '401')}}
    <h1>
      You do not have permission to open this project.
    </h1>
  {{else if (eq this.firstError.status '404')}}
    <h1> Project Not Found </h1>
  {{else}}
    <h1>
      Sorry, something went wrong while trying to load this project.
    </h1>
    <p>{{this.firstError.title}}</p>
  {{/if}}
  <p class='mt4'>
    <LinkTo class='yellow underline' @route='user'>Back to your projects</LinkTo>
  </p>
</div>