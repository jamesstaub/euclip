{{!-- 
  this template for the /track/:id route is rendered as the footer for the currently selected track
 --}} 
<TrackFooterContainer
  @track={{@model}}
  @toggleSidebar={{fn this.toggleSidebar @track.id}}
  @showFilePath={{this.showFilePath}}
  @selectedSourceIdx={{this.projectUi.selectedSourceIdx}}
  @onSelectSourceNode={{this.selectSourceNode}}
  @rightSidebarOpen={{this.projectUi.rightSidebarOpen}}
  @leftSidebarOpen={{this.projectUi.leftSidebarOpen}}
/>

{{outlet}}