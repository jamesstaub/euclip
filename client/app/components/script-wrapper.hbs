<div class="relative flex overflow-hidden flex-column mh3-ns mh2 script-wrapper">
  {{#if this.showScripts}}
    <div class="flex flex-wrap justify-between">
      <Console::TabMenu
        @selectedClass="bw1 pv1 bg-dark-gray b--light-gray light-gray z-2 no-bottom"
        @buttonClass="bn pv1 bg-near-black moon-gray no-bottom no-bottom"
        @onSelect={{this.setScriptTypeTab}}
        @selectedValue={{"init"}}
        @items={{compact
          (array
            (hash label="setup" value="init" beacon=@track.initScript.alert )
            (if
              @track.onstepScript
              (hash label="play" value="onstep" beacon=@track.onstepScript.alert)
            )
            (if
              @project.macrosScript
              (hash label="macros" value="macros" beacon=@project.macrosScript.alert)
            )
          )
        }}
      />
      
      <div class="flex flex-column">
        <button
          class="textbutton tl light-gray f6"
          type="button"
          data-test-open-macros
          {{on "click" this.openMacroMenu}}
        >
          Macros
        </button>

        {{!-- <button
          class="textbutton tl light-gray f6"
          type="button"
          {{on "click" this.openPresets}}
        >
          Presets
        </button> --}}

        {{!-- <button
          class="textbutton tl light-gray f6"
          type="button"
          {{on "click" this.openGUI}}
        >
          Code Generator
        </button> --}}
      </div>
    </div>
  {{/if}}

  {{#if this.showMacroMenu}}
    <MacroMenu
      @onSubmit={{this.applyMacro}}
      @closeMenu={{this.backToScript}}
    />
  {{/if}}

  {{#if this.showPresets}}
    <PresetMenu
      {{did-update this.setDefaultPreset @track.selectedPreset.id}}
      @track={{@track}}
      @presetCollections={{@presetCollections}}
      @onSubmit={{this.applyPreset}}
      @closeMenu={{this.backToScript}}
    />
  {{/if}}
  
  {{#if this.showSignalGui}}
    <SignalChainCreator
      @trackNodes={{@model.trackNodes}}
      @onGenerateScript={{fn this.updateSignalChain @track.initScript}}
      @onSubmit={{fn this.createScriptFromGUI @track.initScript}}
      @onCancel={{this.backToScript}}
    />
  {{/if}}

  {{#if this.showInitScript}}
    <ScriptEditor
      @scriptModel={{@track.initScript}}
      @editorContent={{@track.initScript.editorContent}}
      @editorLineCount={{this.editorLineCount}}
    />
  {{/if}}

  {{#if this.showOnstepScript}}
    <ScriptEditor
      @scriptModel={{@track.onstepScript}}
      @editorContent={{@track.onstepScript.editorContent}}
      @editorLineCount={{this.editorLineCount}}
    />
  {{/if}}

  {{#if this.showMacrosScript}}
    {{!-- project-wide: one script for the whole project, run before any track's script --}}
    <p class="light-gray f7 mt2 mb2" data-test-macros-script-note>
      Macros script: shared by every track in this project. It runs before the tracks' setup scripts.
    </p>
    <ScriptEditor
      @scriptModel={{@project.macrosScript}}
      @editorContent={{@project.macrosScript.editorContent}}
      @editorLineCount={{this.editorLineCount}}
    />
  {{/if}}
</div>
