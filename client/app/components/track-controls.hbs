{{#each @trackNodesForControls as |trackNode idx|}}
  {{#if (eq @visibleNodeIdx idx)}}
    <div class='flex overflow-hidden h-100'>
      <Controls::NodeControls
        @track={{@track}}
        @trackNode={{trackNode}}
        @updateControl={{@updateControl}}
      />
    </div>
  {{/if}}
{{/each}}