{{! template-lint-disable no-down-event-binding }}
{{! the "/" shortcut to focus the search box is a keydown, as in any file browser }}
<SidebarWrapper
  @direction='left'
  @title={{this.title}}
  @onCloseSidebar={{@onCloseSidebar}}
  data-test-sound-browser
  {{on 'keydown' this.onKeydown}}
>
  <:info>
    <InfoBox>
      <p class='f6 mb3 mt0'>Click a sound to hear it. <b>Use</b> (or Enter) puts it where the <b>Adding to</b> card says,
        then moves on to the next empty sampler, so a kit fills one pick after another. <b>Undo</b> brings the old sound back.</p>
      <p class='f6 mb3 mt0'>The sound's URL is available in the code as <code>this.files[n]</code>, one per sampler:
        <code>__().sampler({path: this.files[0]})</code>.</p>
      <p class='f6 mb3 mt0'><b>In this project</b> lists the sounds already in use. Choose <b>New tracks</b> in the card to
        make a track for each sound you tick, or one kit from two to four of them.</p>
    </InfoBox>
  </:info>
  <:default>
    <Sounds::TargetCard
      @track={{@activeTrack}}
      @mode={{@audioSelectMode}}
      @selectedIdx={{this.targetNodeIdx}}
      @onSelectSampler={{this.selectSampler}}
      @onNewTracks={{this.targetNewTracks}}
    />

    <FilePicker::Search
      @onSelectFile={{this.onSelectFileFromSearch}}
      @audioFileTree={{this.audioFileTreeForMode}}
      @showCheck={{this.isCreateTracksMode}}
      @selectedPaths={{this.selectedPaths}}
      @badges={{this.badges}}
    >
      {{#if this.isCurrentTrackMode}}
        <Sounds::Segmented
          @label='Which sounds'
          @items={{this.segments}}
          @selected={{this.segment}}
          @onSelect={{this.setSegment}}
        />
      {{/if}}

      {{#if this.showPool}}
        <Project::SamplePool
          @project={{@project}}
          @activeTrack={{@activeTrack}}
          @badges={{this.badges}}
          @onUse={{this.useSound}}
        />
      {{else}}
        <FilePicker::Breadcrumbs @audioFileTree={{this.audioFileTreeForMode}} @onUp={{this.goUp}} />
        <Sounds::List
          @directory={{this.currentDirectory}}
          @badges={{this.badges}}
          @showCheck={{this.isCreateTracksMode}}
          @selectedPaths={{this.selectedPaths}}
          @onOpenFolder={{this.openFolder}}
          @onUp={{this.goUp}}
          @onUse={{this.useSound}}
          @onToggle={{this.toggleFileSelection}}
        />
        <p class='sound-hints' aria-hidden='true'>
          <span><kbd>↑</kbd><kbd>↓</kbd> hear</span><span><kbd>⏎</kbd> use</span><span><kbd>→</kbd> open</span><span><kbd>←</kbd> up</span>
        </p>
      {{/if}}
    </FilePicker::Search>

    {{#if (and this.isCreateTracksMode this.selectedFiles.length)}}
      <Sounds::SelectionTray
        @files={{this.selectedFiles}}
        @busy={{this.isCreating}}
        @kitDisabled={{this.kitDisabled}}
        @onRemove={{this.toggleFileSelection}}
        @onTracks={{this.submitSelectedFiles}}
        @onKit={{this.createKit}}
      />
    {{/if}}
  </:default>
</SidebarWrapper>
