<div class='mh3' role='search'>
  <div class='flex items-center ba bw1 b--yellow br3 ph3 bg-black-20 moon-gray focus-within-blue'>
    <span class='glyph-search mr2' aria-hidden='true'></span>
    <Input
      aria-label='Search for Drum Sounds'
      class='bn bg-transparent light-gray f5 pv3 flex-auto min-w-0 outline-0'
      placeholder='Search sounds…'
      data-test-sound-search
      @value={{this.searchQuery}}
      {{on 'keyup' this.search}}
    />
    {{#if this.searchResults.length}}
      <Ui::Button @variant='ghost' @size='s' data-test-search-clear {{on 'click' this.backToBrowse}}>Clear</Ui::Button>
    {{else}}
      <kbd class='glyph-slash f7 ba b--white-30 br1 ph1' aria-hidden='true'></kbd>
    {{/if}}
  </div>
</div>

<ProgressBar class={{concat 'fixed top-0 mv1 mh3 ' (unless this.searchTask.isRunning 'hidden')}} />

{{#if this.searchResults.length}}
  <div class='sidebar-fill scroll-y flex flex-column' data-test-search-results>
    <ul class='list pl0 ma0 ph2 flex-none' aria-label='Search results'>
      {{#each this.groups as |group|}}
        <li class='mb2'>
          <h3 class='f7 ttu fw6 yellow mt3 mb1 mh2' data-test-group-name>{{group.folder}}</h3>
          <ul class='list pl0 ma0'>
            {{#each group.rows as |row|}}
              <Sounds::Row
                @role='listitem'
                @name={{row.name}}
                @path={{row.path}}
                @playing={{row.playing}}
                @loading={{row.loading}}
                @badge={{row.badge}}
                @showCheck={{@showCheck}}
                @checked={{row.checked}}
                @showUse={{not @showCheck}}
                @onPlay={{fn this.audition row.path}}
                @onSelect={{fn this.audition row.path}}
                @onUse={{fn this.onSelectSearchResult row.path}}
                @onToggle={{fn this.onSelectSearchResult row.path}}
              />
            {{/each}}
          </ul>
          {{#if group.canExpand}}
            <Ui::Button @variant='ghost' @size='s' class='ml1 underline' {{on 'click' (fn this.toggleExpanded group.folder)}}>
              {{if group.open 'Show fewer' (concat 'Show all ' group.total)}}
            </Ui::Button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
    <SearchPagination
      class='pv2'
      @currentPage={{this.currentPage}}
      @lastPage={{this.lastPage}}
      @search={{fn this.search this.searchQuery}}
    />
  </div>
{{else}}
  {{yield}}
{{/if}}
