<nav class='crumbs' aria-label='Folder' data-test-file-breadcrumbs ...attributes>
  <button
    type='button'
    class='crumbs__up'
    aria-label='Up one folder'
    title='Up one folder (←)'
    disabled={{this.atRoot}}
    data-test-folder-up
    {{on 'click' @onUp}}
  >‹</button>
  <ol class='crumbs__list'>
    {{#each this.items as |item|}}
      <li>
        <button
          type='button'
          class='crumbs__item {{if item.current "crumbs__item--current"}}'
          aria-current={{if item.current 'location'}}
          data-test-file-breadcrumb={{item.path}}
          {{on 'click' (fn this.go item)}}
        >{{item.label}}</button>
      </li>
    {{/each}}
  </ol>
</nav>
