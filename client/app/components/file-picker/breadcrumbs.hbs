<nav class='flex flex-wrap items-center ph3 pv2 f6' aria-label='Folder' data-test-file-breadcrumbs ...attributes>
  {{#each this.items as |item index|}}
    {{#if index}}<span class='gray mh1' aria-hidden='true'>/</span>{{/if}}
    <button
      type='button'
      class='textbutton pa1 {{if item.current "fw7"}}'
      aria-current={{if item.current 'location'}}
      data-test-file-breadcrumb={{item.path}}
      {{on 'click' (fn this.go item)}}
    >{{item.label}}</button>
  {{/each}}
</nav>
