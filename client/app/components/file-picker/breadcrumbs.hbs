<nav class='flex items-center ph3 pv1 f6 light-gray' aria-label='Folder' data-test-file-breadcrumbs ...attributes>
  <Ui::Button
    @variant='ghost'
    @size='s'
    class='f4 mr1'
    aria-label='Up one folder'
    title='Up one folder (←)'
    disabled={{this.atRoot}}
    data-test-folder-up
    {{on 'click' @onUp}}
  >‹</Ui::Button>
  <ol class='list pl0 ma0 flex flex-wrap items-center'>
    {{#each this.items as |item index|}}
      <li class='flex items-center'>
        {{#if index}}<span class='moon-gray mh1' aria-hidden='true'>›</span>{{/if}}
        <button
          type='button'
          class='bn bg-transparent pa1 br2 f6 light-gray pointer hover-bg-white-10 {{if item.current "fw7"}}'
          aria-current={{if item.current 'location'}}
          data-test-file-breadcrumb={{item.path}}
          {{on 'click' (fn this.go item)}}
        >{{item.label}}</button>
      </li>
    {{/each}}
  </ol>
</nav>
