{{!-- One of several shelves: a row of buttons, the chosen one solid. Items are { value, label, count?, showCount? }. --}}
<div class='flex pa1 br3 {{if (eq @on "yellow") "bg-black-10" "bg-black-30"}}' role='group' aria-label={{@label}} ...attributes>
  {{#each @items as |item|}}
    <Ui::Button
      @variant='ghost'
      @size='s'
      @on={{@on}}
      @pressed={{eq @selected item.value}}
      @muted={{not (eq @selected item.value)}}
      class='flex-auto br2'
      data-test-segment={{item.value}}
      {{on 'click' (fn @onSelect item.value)}}
    >{{item.label}}{{#if item.showCount}} <b>{{item.count}}</b>{{/if}}</Ui::Button>
  {{/each}}
</div>
