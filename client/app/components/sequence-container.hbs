<div class='flex grow-1'>
  <div class='flex justify-between grow-1'>
    <div class='sequence-control-sliders flex flex-column mh2 w-100 mw7'>
      <Console::Header>Sequencer</Console::Header>
      {{#if @showReference}}
        {{yield}}
      {{else}}
        {{!-- the same tab buttons as the node tabs: the chosen one dark, the rest outlined, square corners --}}
        <Console::TabMenu
          class='mb2 flex-nowrap grow-0 shrink-0'
          aria-label='Sequencer type'
          @selectedClass='bn mr2 bg-dark-gray light-gray'
          @buttonClass='ba bw1 mr2 bg-transparent b--dark-gray dark-gray'
          @onSelect={{fn @updateTrackSequence @sequence 'kind'}}
          @items={{this.kinds}}
          @selectedValue={{this.kind}}
          data-test-sequencer-kinds
        />
        {{#if (eq this.kind 'binary')}}
          <Sequence::Slider
            @label="value"
            @value={{@sequence.value}}
            @min={{0}}
            @max={{127}}
            @onChange={{fn @updateTrackSequence @sequence 'value'}}
          />
        {{else if (eq this.kind 'onoff')}}
          <Sequence::Slider
            @label="on"
            @value={{@sequence.onSteps}}
            @min={{0}}
            @max={{16}}
            @onChange={{fn @updateTrackSequence @sequence 'onSteps'}}
          />
          <Sequence::Slider
            @label="off"
            @value={{@sequence.offSteps}}
            @min={{0}}
            @max={{16}}
            @onChange={{fn @updateTrackSequence @sequence 'offSteps'}}
          />
          <Sequence::Slider
            @label="times"
            @value={{@sequence.times}}
            @min={{1}}
            @max={{16}}
            @onChange={{fn @updateTrackSequence @sequence 'times'}}
          />
        {{else}}
          <Sequence::Slider
            @label="hits"
            @value={{@sequence.hits}}
            @min={{0}}
            @max={{@sequence.steps}}
            @onChange={{fn @updateTrackSequence @sequence 'hits'}}
          />
          <Sequence::Slider
            @label="steps"
            @value={{@sequence.steps}}
            @min={{0}}
            @max={{@maxSteps}}
            @onChange={{fn @updateTrackSequence @sequence 'steps'}}
          />
          <Sequence::Slider
            @label="offset"
            @value={{@sequence.offset}}
            @min={{0}}
            @max={{@maxSteps}}
            @onChange={{fn @updateTrackSequence @sequence 'offset'}}
          />
        {{/if}}
      {{/if}}
    </div>
  </div>
</div>
