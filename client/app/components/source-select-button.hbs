{{#if this.kind}}
  <ButtonPrimary
    class='ba {{unless this.isMultiSample "w4"}} {{if this.isMultiSample "source-kit"}} f7 bg-dark-gray glowing-txt ma2 relative flex items-center justify-center {{this.classNames}}'
    {{on 'click' @onClick}}
    @restyle={{true}}
    @label={{this.label}}
    data-test-source-kind={{this.kind}}
    ...attributes
  >
    {{#if this.isSample}}
      <span class='truncate' data-test-source-label>{{if this.filename this.filename 'Pick a Sound'}}</span>
    {{else if this.isMultiSample}}
      {{! one dot per sampler: filled when it has a sound }}
      <span class='slot-dots flex-none mr2' aria-hidden='true'>
        {{#each this.slotStates as |filled|}}<i class='slot-dot {{unless filled "slot-dot--empty"}}'></i>{{/each}}
      </span>
      <span class='truncate' data-test-source-label>{{this.loadedCount}} / {{this.sampleCount}} samplers</span>
    {{else if this.hasWaveform}}
      <svg class='flex-none mr2' width='32' height='14' viewBox='0 0 32 14' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linejoin='round' aria-hidden='true'>
        <path d={{this.waveformPath}} />
      </svg>
      <span class='truncate' data-test-source-label>{{this.sourceName}}</span>
    {{else if this.isMacro}}
      {{! stacked layers: an instrument made of several parts }}
      <svg class='flex-none mr2' width='14' height='14' viewBox='0 0 14 14' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linejoin='round' aria-hidden='true'>
        <path d='M7 1 L13 4 L7 7 L1 4 Z' />
        <path d='M1 7 L7 10 L13 7' />
        <path d='M1 10 L7 13 L13 10' />
      </svg>
      <span class='truncate' data-test-source-label>{{this.sourceName}}</span>
    {{/if}}
    {{#if this.fileError}}
      <span class='absolute beacon right-1' title={{this.fileError}}>⬤</span>
    {{/if}}
  </ButtonPrimary>
{{/if}}
