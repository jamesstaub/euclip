<div
  class={{if @on 'ba bw1 b--mid-gray br1'}}
  ...attributes
  {{nexus-ui
    'Number'
    value=@value
    min=this.min
    max=this.max
    step=0.0001
    dragStep=this.step
    dragPerPixel=this.dragPerPixel
    onChange=@onChange
    fill=this.fill
    text=this.text
    size=(or @size (array 60 30))
  }}
></div>
