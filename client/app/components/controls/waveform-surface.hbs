{{! template-lint-disable no-down-event-binding }}
{{! the markers are dragged: a drag has to start on press, not release }}
<div
  class='surface-wrapper waveform-surface {{unless this.isLooping "is-loop-off"}} flex flex-column items-center mr2 ba b--dark-gray bw1 bg-dark-yellow'
  data-test-waveform-surface
>
  <div class='flex items-center justify-between spaced-text ttu bg-dark-gray white f7 fw3 w-100 pv2 ph2'>
    <span class='fw7 light-gray'>sample</span>
    <span>{{display-float this.duration}} sec</span>
  </div>
  <div class='pa2'>
    <div class='waveform-area relative bg-dark-gray'>
      <canvas
        class='waveform-canvas db'
        width='720'
        height='200'
        {{audio-waveform @buffer color='#52ebff' cursorColor='#f4f4f4'}}
      ></canvas>
      {{#if this.activeSliceStyle}}
        <div class='waveform-active-slice absolute' style={{this.activeSliceStyle}} data-test-active-slice></div>
      {{/if}}
      {{#each this.onsetMarkers as |marker|}}
        <div
          class='waveform-onset absolute'
          style={{marker.style}}
          title='Slice {{marker.index}} starts at {{display-float marker.time}}s'
          data-test-onset-marker
          data-time={{marker.time}}
        ></div>
      {{/each}}
      <div class='waveform-shade absolute left-0' style={{this.shadeLeftStyle}}></div>
      <div class='waveform-shade absolute right-0' style={{this.shadeRightStyle}}></div>
      <div
        class='waveform-handle absolute'
        style={{this.startHandleStyle}}
        role='slider'
        aria-label='Sample start'
        aria-valuenow={{this.startSeconds}}
        data-test-waveform-handle='start'
        {{on 'pointerdown' (fn this.beginDrag 'start')}}
      ></div>
      <div
        class='waveform-handle absolute'
        style={{this.endHandleStyle}}
        role='slider'
        aria-label='Sample end'
        aria-valuenow={{this.endSeconds}}
        data-test-waveform-handle='end'
        {{on 'pointerdown' (fn this.beginDrag 'end')}}
      ></div>
    </div>
  </div>
  {{!-- start and end are drawn here, so their unit is chosen here: seconds, ms, % of the sample, loop steps or slices --}}
  <div class='flex items-center justify-between w-100 ph2 pb1 f7 dark-gray'>
    <div class='flex items-center'>
      <span class='mr1'>start</span>
      <select class='f7 bn bg-transparent dark-gray' aria-label='Unit of the sample start' data-test-start-unit {{on 'change' (fn this.setUnit @startControl)}}>
        {{#each @startControl.paramUnitNames as |name idx|}}
          <option value={{idx}} selected={{eq name @startControl.currentParamUnitLabel}}>{{name}}</option>
        {{/each}}
      </select>
      <span class='ml1' data-test-start-value>{{display-float @startControl.controlValue}}</span>
    </div>
    <div class='flex items-center'>
      <span class='mr1'>end</span>
      <select class='f7 bn bg-transparent dark-gray' aria-label='Unit of the sample end' data-test-end-unit {{on 'change' (fn this.setUnit @endControl)}}>
        {{#each @endControl.paramUnitNames as |name idx|}}
          <option value={{idx}} selected={{eq name @endControl.currentParamUnitLabel}}>{{name}}</option>
        {{/each}}
      </select>
      <span class='ml1' data-test-end-value>{{display-float @endControl.controlValue}}</span>
    </div>
  </div>
  <div class='flex items-center justify-between w-100 ph2 pb2 f7 dark-gray'>
    {{#if this.showSnap}}
      <label class='flex items-center' title='Markers jump to the nearest onset, or the start or end of the file'>
        <input
          type='checkbox'
          class='mr1'
          checked={{this.snapOn}}
          data-test-snap-toggle
          {{on 'change' this.toggleSnap}}
        />
        snap
      </label>
    {{/if}}
    <span data-test-slice-count>{{this.sliceCount}} slices</span>
    {{#if this.sample}}
      <label class='flex items-center' title='Onset threshold: lower finds more, quieter onsets'>
        <span class='mr1'>onset threshold</span>
        <input
          type='range'
          min='0'
          max='1'
          step='0.01'
          value={{this.threshold}}
          class='threshold-slider'
          data-test-onset-threshold
          {{on 'input' this.setThreshold}}
        />
      </label>
    {{/if}}
  </div>
</div>
