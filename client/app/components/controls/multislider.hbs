{{!-- The box takes whatever height is left in the panel; the sliders are drawn in a child that does not affect that
      size, as tall as the box (see measure-height). --}}
<div class='relative flex-auto overflow-hidden' style={{this.boxStyle}} {{measure-height this.setHeight}}>
  <div
    class='absolute top-0 left-0 multislider-bg'
    {{nexus-ui-multislider
      min=@min
      max=@max
      stepIndex=@stepIndex
      numberOfSliders=@sequence.length
      values=@values
      sequence=@sequence
      step=@stepSize
      size=(array this.width this.height)
      onChange=@onChange
      smoothing=0
      mode='bar'
    }}
  >
  </div>
</div>

{{yield}}
{{!-- multislider controls:
  apply on: every step, only steps with beat
 --}}
