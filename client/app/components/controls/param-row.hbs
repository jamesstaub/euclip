<li
  class='controls-wrapper flex items-center ba bw1 b--dark-gray br2 bg-dark-yellow ph2 min-w-0'
  data-test-param={{@trackControl.nodeAttr}}
  ...attributes
>
  <span class='flex-none w4 mr2 f7 ttu fw6 dark-gray truncate' title={{@trackControl.nodeAttr}}>{{@trackControl.nodeAttr}}</span>

  <div class='flex items-center flex-auto min-w-0'>
    {{yield}}
  </div>

  {{#if this.singleUnit}}
    <span class='flex-none ml2 f7 dark-gray nowrap' data-test-param-unit>{{this.singleUnit}}</span>
  {{else if this.hasUnitChoice}}
    <div
      class='nexus-select flex-none ml2'
      {{nexus-ui
        'Select'
        value=@trackControl.currentParamUnitLabel
        size=(array 84 22)
        options=@trackControl.paramUnitNames
        onChange=this.setParamUnit
      }}
    ></div>
  {{/if}}

  <BasicDropdown @horizontalPosition='auto-right' as |dd|>
    <dd.Trigger
      class='flex-none bn bg-transparent pa1 ml1 f5 dark-gray pointer'
      aria-label='Settings for {{@trackControl.nodeAttr}}'
      title='Range, step, default'
      data-test-control-config
    >⋮</dd.Trigger>
    <dd.Content class='bg-dark-gray ba bw2 b--light-gray shadow-3 pa2 light-gray' data-test-control-config-panel>
      <p class='f7 ttu fw6 yellow mt0 mb2'>{{@trackControl.nodeAttr}}</p>
      <Controls::ControlConfig @trackControl={{@trackControl}} />
      <Ui::Button
        @size='s'
        class='mt2 mr2'
        aria-label='Toggle Multislider Mode'
        title='Give this parameter a value for every step of the sequence'
        data-test-multislider-toggle
        {{on 'click' this.toggleInterface}}
      >Per-step values</Ui::Button>
      <Ui::Button
        @size='s'
        class='mt2'
        disabled={{not @trackControl.isOverridden}}
        title={{if @trackControl.isOverridden (concat 'Back to ' @trackControl.defaultValue) 'Already at its default'}}
        data-test-reset-control
        {{on 'click' (fn this.resetControl dd)}}
      >Reset this</Ui::Button>
    </dd.Content>
  </BasicDropdown>
</li>
