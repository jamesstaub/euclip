<section class='sampler-rack' aria-label='Samplers' data-test-sampler-rack>
  {{#if this.isKit}}
    <p class='sampler-rack__count'>{{this.total}} samplers · {{this.loadedCount}} loaded</p>
  {{/if}}
  <ul class='sampler-rack__cards'>
    {{#each this.cards key='slot' as |card|}}
      <li
        class='sampler-card {{if card.selected "sampler-card--selected"}} {{unless card.path "sampler-card--empty"}} {{if card.target "sampler-card--target"}}'
        data-test-sampler-card={{card.number}}
        data-source-node-id={{card.node.scriptId}}
      >
        {{#if card.target}}<span class='sampler-card__ring' aria-hidden='true'>adding here</span>{{/if}}
        <button
          type='button'
          class='sampler-card__main'
          aria-pressed={{if card.selected 'true' 'false'}}
          aria-label={{card.label}}
          data-test-sampler-select
          {{on 'click' (if card.path (fn this.select card) (fn this.add card))}}
        >
          <span class='sampler-card__head'>
            {{#if card.path}}
              <span class='sampler-card__name' data-test-sampler-name>{{card.name}}</span>
            {{else}}
              <span class='sampler-card__add' data-test-sampler-add><b aria-hidden='true'>＋</b> Add a sound</span>
            {{/if}}
            <span class='sampler-card__title'>{{card.title}}{{#if card.idLabel}} <i>{{card.idLabel}}</i>{{/if}}</span>
          </span>
        </button>
        {{#if card.path}}
          {{#if card.buffer}}
            <canvas class='sampler-card__wave' width='240' height='36' aria-hidden='true' {{audio-waveform card.buffer}}></canvas>
          {{else if card.error}}
            <span class='sampler-card__wave sampler-card__wave--note red' title={{card.error}}>download failed</span>
          {{else}}
            <span class='sampler-card__wave sampler-card__wave--note'>loading…</span>
          {{/if}}
        {{/if}}
        {{#if card.path}}
          <div class='sampler-card__actions'>
            <button
              type='button'
              class='sampler-card__icon'
              aria-label='{{if card.playing "Stop" "Audition"}} {{card.name}}'
              data-test-sampler-audition
              {{on 'click' (fn this.audition card)}}
            >{{if card.playing '■' '▶'}}</button>
            {{#if card.durationText}}<span class='sampler-card__duration'>{{card.durationText}}</span>{{/if}}
            {{#if card.caption}}
              <button
                type='button'
                class='sampler-card__where'
                title='Show {{card.name}} in the sound browser'
                data-test-sampler-where
                {{on 'click' (fn this.showInBrowser card)}}
              >{{card.caption}}</button>
            {{/if}}
            <button
              type='button'
              class='sampler-card__icon'
              aria-label='Change the sound of {{card.title}}'
              title='Change'
              data-test-sampler-change
              {{on 'click' (fn this.add card)}}
            >⇄</button>
            <button
              type='button'
              class='sampler-card__icon'
              aria-label='Clear {{card.title}}'
              title='Clear'
              data-test-sampler-clear
              {{on 'click' (fn this.clear card)}}
            >✕</button>
          </div>
        {{/if}}
      </li>
    {{/each}}
  </ul>
</section>
