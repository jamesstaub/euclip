<section class='mb2' aria-label='Samplers' data-test-sampler-rack>
  {{#if this.isKit}}
    <p class='f7 mt0 mb1 mid-gray' data-test-rack-count>{{this.total}} samplers · {{this.loadedCount}} loaded</p>
  {{/if}}
  {{!-- any number of samplers: the cards wrap into rows and scroll past about two --}}
  <ul class='list pl0 ma0 rack-grid max-h-rack scroll-y' data-test-rack-cards>
    {{#each this.cards key='slot' as |card|}}
      <li
        class='min-w-0'
        data-test-sampler-card={{card.number}}
        data-source-node-id={{card.node.scriptId}}
        data-state={{card.state}}
        {{sound-drop (fn this.dropSound card)}}
        {{scroll-into-view card.selected 'smooth'}}
      >
        <Ui::Card @on='yellow' @state={{card.state}} class='flex flex-column h-100'>
          {{#if card.target}}<span class='absolute top-0 right-1 nt2 f7 fw7 bg-light-blue near-black br-pill ph2' aria-hidden='true'>adding here</span>{{/if}}
          <button
            type='button'
            class='stretched bn bg-transparent pa0 tl w-100 near-black pointer {{unless card.path "pv2"}}'
            aria-pressed={{if card.selected 'true' 'false'}}
            aria-label={{card.label}}
            data-test-sampler-select
            {{on 'click' (if card.path (fn this.select card) (fn this.add card))}}
          >
            <span class='flex justify-between items-baseline min-w-0'>
              {{#if card.path}}
                <span class='f6 fw6 truncate' data-test-sampler-name>{{card.name}}</span>
              {{else}}
                <span class='flex items-center f6 fw6' data-test-sampler-add><b class='f5 mr1' aria-hidden='true'>＋</b> Add a sound</span>
              {{/if}}
              <span class='f7 ttu fw6 dark-gray flex-none ml2'>{{card.title}}{{#if card.idLabel}} <i class='fw4 ttn'>{{card.idLabel}}</i>{{/if}}</span>
            </span>
          </button>
          {{#if card.path}}
            {{#if card.buffer}}
              <canvas class='db w-100 h-wave' width='240' height='36' aria-hidden='true' {{audio-waveform card.buffer}}></canvas>
            {{else if card.error}}
              <span class='db f7 red h-wave' title={{card.error}}>download failed</span>
            {{else}}
              <span class='db f7 mid-gray h-wave'>loading…</span>
            {{/if}}
            <div class='relative z-1 flex items-center f7 dark-gray min-w-0'>
              <Ui::Button @variant='ghost' @size='s' @on='yellow' aria-label='{{if card.playing "Stop" "Audition"}} {{card.name}}' data-test-sampler-audition {{on 'click' (fn this.audition card)}}>{{if card.playing '■' '▶'}}</Ui::Button>
              {{#if card.durationText}}<span class='flex-none mr1' data-test-sampler-duration>{{card.durationText}}</span>{{/if}}
              {{#if card.caption}}
                <Ui::Button
                  @variant='ghost'
                  @size='s'
                  @on='yellow'
                  class='flex-auto tl truncate underline'
                  title='Show {{card.name}} in the sound browser'
                  data-test-sampler-where
                  {{on 'click' (fn this.showInBrowser card)}}
                >{{card.caption}}</Ui::Button>
              {{else}}
                <span class='flex-auto'></span>
              {{/if}}
              <Ui::Button @variant='ghost' @size='s' @on='yellow' aria-label='Change the sound of {{card.title}}' title='Change' data-test-sampler-change {{on 'click' (fn this.add card)}}>⇄</Ui::Button>
              <Ui::Button @variant='ghost' @size='s' @on='yellow' aria-label='Clear {{card.title}}' title='Clear' data-test-sampler-clear {{on 'click' (fn this.clear card)}}>✕</Ui::Button>
            </div>
          {{/if}}
        </Ui::Card>
      </li>
    {{/each}}
  </ul>
</section>
