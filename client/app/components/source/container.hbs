{{!-- <Oscilloscope
  @id={{concat @track.id 'scope'}}
  @node={{@track.nodeToVisualize}}
  @fill='#ffce55'
  @accent='#000000'
/> --}}
<div class='flex justify-between w-auto grow-1'>
  <div class='flex w-auto mh1 flex-column grow-1 min-w-0'>
    <Console::Header>Source</Console::Header>

      {{!-- a sampler track shows what each sampler holds as cards; other sources (oscillators, macros) keep their tabs --}}
      {{#if this.isSamplerTrack}}
        <Source::SamplerRack
          @track={{@track}}
          @selectedIdx={{this.visibleNodeIdx}}
          @onSelect={{@onSelectNode}}
          @onShowFilePath={{@showFilePath}}
        />
      {{else}}
        <Source::NodeTabs
          @nodes={{@track.sourceNodeRecords}}
          @onSelect={{@onSelectNode}}
          @selectedValue={{this.visibleNodeIdx}}
        />
      {{/if}}

    {{#if @showReference}}
      {{yield}}
    {{else}}
      {{#if @track.sourceNodeRecords.length}}
      
        {{!-- FIXME: move error to the node itself, not the track --}}
        {{!-- {{#if @track.fileDownloadError}}
          <div class="red bg-dark-gray pa3">
            <p>Error Downloading {{@track.samplerFilepathControl.pathSegments.lastObject}}</p>
            <p>{{@track.fileDownloadError}}</p>
          </div>
        {{/if}} --}}
      {{else}}
        <p class="light-gray bg-dark-gray pa3 mv0">There are no source nodes defined on this track</p>
      {{/if}}
      <TrackControls
        @track={{@track}}
        @trackNodesForControls={{@track.sourceNodesForControls}}
        @visibleNodeIdx={{this.visibleNodeIdx}}
        @updateControl={{@updateControl}}
      />
    {{/if}}
  </div>
</div>