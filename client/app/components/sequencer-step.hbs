<svg width="32" height="32" viewBox="0 0 32 32" ...attributes>
  <rect x="0" y="0" stroke="#333" stroke-linecap="butt" stroke-width="2" width="32" height="32" fill={{this.fill}}></rect>
  {{#if this.label}}
    <text x="16" y="17" text-anchor="middle" dominant-baseline="central" font-size="16" font-weight="700" fill={{this.textFill}} pointer-events="none" data-test-step-value>{{this.label}}</text>
  {{/if}}
</svg>
