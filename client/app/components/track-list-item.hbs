{{!-- template-lint-disable no-invalid-interactive --}}

<div 
  class="pointer no-outline {{if @track.isMaster "pl4 " "pl3"}} bb b--silver {{if @isActive "bg-yellow" "bg-dark-gray hover-bg-gray"}}" 
  tabindex="0"
  data-test-track-item
  data-track-id={{@track.id}}
  {{on "click" @selectActiveTrack}}
  {{focus @isActive}}
  ...attributes
>
  <div class="track-row pr3">
    <span class="track-row__order f3 code {{unless @isActive "yellow"}}">{{@track.order}}</span>
    <div class="track-row__source flex items-center">
      {{#if @track.isMaster}}
        <p class="truncate tc pv2 ph3 ml2 f6 ttu bg-dark-gray yellow ba bw1 b--yellow w4 f7">Main Output</p>
        {{#if @track.nodeToVisualize}}
          <div class="track-row__scope overflow-hidden">
            <Oscilloscope class="ml3 pl1" @id={{concat @track.id '-scope'}} @isActive={{@isActive}} @node={{@track.nodeToVisualize}} @fill="#333333" @accent="#52ebff" />
          </div>
        {{/if}}
      {{/if}}
      
      {{#if this.showSourceButton}}
        {{!-- one button for the track's source, whatever kind it is; opens the footer's source tab --}}
        <SourceSelectButton @track={{@track}} @onClick={{this.showSource}} />
      {{else}}
        {{#unless @track.isMaster}}
          <p class="tc w4 ma2 {{unless @isActive "light-gray"}}">
            {{#if this.samplerBuildFailed}}
              <span
                {{on "click" @onToggleScripts}}
                class="f6 pa1 red"
                data-test-source-failed
                title={{or @track.scriptAlert "The sampler could not be built; open the script to see why"}}
              >Sampler failed (see script)</span>
            {{else}}
              <span {{on "click" @onToggleScripts}} class="f6 pa1" data-test-no-source>No Source Node</span>
            {{/if}}
          </p>
        {{/unless}}
      {{/if}}
    </div>

    {{yield}}

    <div class="track-row__sequence">
      {{#if (and (not @track.isMaster) @track.currentSequence.sequence)}}
        <TrackSequencer 
          @sequence={{@track.currentSequence.sequence}}
          @stepIndex={{@track.stepIndex}}
          @onClickStep={{this.updateTrackSequence}}
          @isCurrentTrack={{@isActive}}
        />
      {{/if}}
    </div>
    {{!-- stays in the grid whether or not the scripts button is shown, so the row never reflows when a sidebar opens --}}
    <div class="track-row__actions flex items-center h-100">
      <ShowScriptBtn
        @rightSidebarOpen={{@rightSidebarOpen}}
        @isActive={{@isActive}}
        @onToggleScripts={{@onToggleScripts}}
        @track={{@track}}
      />

      {{#if (not (or @track.isSaving @track.isDestroying))}}
        {{!-- opening this menu must not also select (navigate to) the track --}}
        <div class="h-100 flex" {{on "click" this.stopPropagation}}>
          <DropdownMenu 
            class="h-100 grow-1 {{if @isActive "dark-fill" "yellow-fill"}} bn bg-transparent"
            @closeOnSelect={{true}}
            @items={{array 
              (hash label="delete" select=this.deleteTrack) 
              (hash label="duplicate" select=this.duplicateTrack) 
            }}
          />
        </div>
      {{/if}}
    </div>
  </div>
</div>
