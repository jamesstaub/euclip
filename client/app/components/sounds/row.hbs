{{!--
  One row of a sound list: a folder (opens), or a sound (audition, select, Use). Shared by the folder list,
  the search results and the "In this project" shelf, so they all look and behave the same.
  Args: @current (the sound the target sampler holds), @role (default option; 'listitem' outside a listbox), @name, @path,
        @folder, @selected, @playing, @loading, @detail, @badge, @showCheck, @checked, @showUse (the Use button),
        @onOpen (folder), @onPlay, @onSelect, @onUse (Use, double-click), @onToggle. A block adds extra controls (a menu).
  Look: tachyons classes; only what needs a hover/focus state of the row (the Use overlay) is in sidebars.css (.sound-row).
--}}
<li
  class='sound-row flex items-center br2 ph2 f6 light-gray hover-bg-white-10 bl bw1
    {{if @selected "bg-yellow-15"}} {{if @current "b--yellow" "b--transparent"}}'
  role={{or @role 'option'}}
  aria-selected={{if @role undefined (if @selected 'true' 'false')}}
  data-test-sound-row
  data-sound-name={{@name}}
  data-sound-path={{@path}}
  data-selected={{if @selected 'true'}}
  data-current={{if @current 'true'}}
  ...attributes
  {{scroll-into-view (or @selected @current) 'smooth'}}
  {{draggable-sound (unless @folder @path)}}
>
  {{#if @folder}}
    <button type='button' class='bn bg-transparent pa0 pv2 flex-auto tl light-gray f6 fw5 pointer flex items-center justify-between min-w-0' data-test-sound-folder {{on 'click' @onOpen}}>
      <span class='truncate'>{{@name}}</span>
      <span class='moon-gray f4 ml2' aria-hidden='true'>›</span>
    </button>
  {{else}}
    {{#if @showCheck}}
      <input
        type='checkbox'
        class='flex-none mr2 accent-yellow'
        checked={{@checked}}
        aria-label='Select {{@name}}'
        data-test-sound-check
        {{on 'change' @onToggle}}
      />
    {{/if}}
    <button
      type='button'
      class='flex-none flex items-center justify-center w2 h2 mr2 pa0 br-100 ba bw1 f7 pointer
        {{if @selected "bg-yellow b--yellow near-black" (if @playing "bg-transparent b--light-blue light-blue" "bg-transparent b--white-30 light-gray")}}'
      aria-label='{{if @playing "Stop" "Audition"}} {{@name}}'
      aria-pressed={{if @playing 'true' 'false'}}
      data-test-sound-play
      {{on 'click' @onPlay}}
    >
      {{#if @playing}}
        <span class='eq' aria-hidden='true'><i></i><i></i><i></i></span>
      {{else if @loading}}
        <span aria-hidden='true'>…</span>
      {{else}}
        <span aria-hidden='true'>▶</span>
      {{/if}}
    </button>
    <button type='button' class='bn bg-transparent pa0 pv2 flex-auto tl light-gray f6 pointer min-w-0' {{on 'click' @onSelect}} {{on 'dblclick' @onUse}}>
      <span class='truncate db'>{{@name}}</span>
    </button>
    {{#if @detail}}<span class='f7 moon-gray flex-none ml2' data-test-sound-detail>{{@detail}}</span>{{/if}}
    {{#if @badge}}<Ui::Badge class='flex-none ml2' data-test-sound-badge>{{@badge}}</Ui::Badge>{{/if}}
    {{#if @showUse}}
      <Ui::Button @variant='solid' @size='s' class='sound-use' data-test-sound-use {{on 'click' @onUse}}>Use <kbd class='o-60'>⏎</kbd></Ui::Button>
    {{/if}}
    {{yield}}
  {{/if}}
</li>
