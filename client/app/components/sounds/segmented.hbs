<div class='segmented' role='group' aria-label={{@label}} ...attributes>
  {{#each @items as |item|}}
    <button
      type='button'
      class='segmented__btn {{if (eq @selected item.value) "is-on"}}'
      aria-pressed={{if (eq @selected item.value) 'true' 'false'}}
      data-test-segment={{item.value}}
      {{on 'click' (fn @onSelect item.value)}}
    >{{item.label}}{{#if item.showCount}} <b>{{item.count}}</b>{{/if}}</button>
  {{/each}}
</div>
