{{#if (eq @controlUiState 'sequence')}}
  <ScriptVariablesList
    @variables={{array 'data' 'index' 'array'}}
    @title={{'sequence'}}
    @description='In the Play script, data is the value of the current step in the sequence: 0 is a rest, 1 is a hit, and a sequence with a higher max value lets steps hold 2, 3... (a Multi-sample kit plays sampler number data). index is the current step in the sequence, array is an array of the step values representing the sequence. '
  />
{{/if}}
{{#if (eq @controlUiState 'source')}}
  <ScriptVariablesList
    @nodeDocs={{true}}
    @variables={{array 'this.filepath'}}
    @validTrackNodes={{@validTrackNodes}}
    @useSourceNode={{true}}
    @title={{'source'}}
    @description={{'this.filepath is a string with the url of an audio file selected from the left sidebar. '}}
  />
{{/if}}
{{#if (eq @controlUiState 'controls')}}
  <ScriptVariablesList
    @nodeDocs={{true}}
    @variables={{array 'this.controls'}}
    @visibleNodeIdx={{@visibleNodeIdx}}
    @validTrackNodes={{@validTrackNodes}}
    @title={{'controls'}}
    @description={{'this.controls holds the live values of the sliders, by node id or type: this.controls.lead.frequency. Read one to do math on the slider value; assign to it to offset the audio for the current step only (the slider keeps its value), e.g. a little random jitter on every step.'}}
  />
{{/if}}