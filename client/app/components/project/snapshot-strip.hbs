<div class='flex items-center flex-wrap' data-test-snapshot-strip role='group' aria-label='Snapshots' ...attributes>
  {{#each this.items key='snapshot.id' as |item|}}
    <div
      class='flex items-center mr2 mv1'
      data-test-snapshot
      data-snapshot-id={{item.snapshot.id}}
      data-snapshot-state={{item.state}}
      data-snapshot-pending={{if item.pending 'true' 'false'}}
    >
      {{#if (eq this.renamingId item.snapshot.id)}}
        <input
          type='text'
          class='f6 pv1 ph2 w4'
          aria-label='Snapshot name'
          value={{item.snapshot.name}}
          {{did-insert this.focusInput}}
          {{on 'keydown' (fn this.onRenameKey item.snapshot)}}
          {{on 'blur' (fn this.commitRename item.snapshot)}}
        />
      {{else}}
        <button
          type='button'
          class='f6 ttu fw6 pv1 ph3 bw1 ba pointer
            {{if item.active "bg-yellow dark-gray b--yellow" "bg-dark-gray yellow b--yellow"}}
            {{if item.pending "o-60"}}'
          aria-pressed={{if item.active 'true' 'false'}}
          title={{if
            item.active
            'Active snapshot (double-click to rename)'
            'Switch to this snapshot on the next step'
          }}
          {{on 'click' (fn @onSwitch item.snapshot)}}
          {{on 'dblclick' (fn this.startRename item.snapshot)}}
        >
          {{item.snapshot.name}}
          <span class='f7 fw4 ml2'>{{item.snapshot.bpm}}</span>
          {{#if item.pending}}<span class='ml1' title='Switching on the next step'>▸</span>{{/if}}
        </button>
        {{#if (and this.canDelete (not item.active))}}
          <button
            type='button'
            class='f7 bn bg-transparent gray pointer ph1'
            aria-label='Delete snapshot {{item.snapshot.name}}'
            title='Delete this snapshot'
            {{on 'click' (fn @onDelete item.snapshot)}}
          >×</button>
        {{/if}}
      {{/if}}
    </div>
  {{/each}}
  <button
    type='button'
    class='f6 ttu fw6 pv1 ph3 bw1 ba b--yellow bg-dark-gray yellow pointer mv1'
    aria-label='Save snapshot'
    title='Save the current state as a new snapshot'
    {{on 'click' @onSave}}
  >+</button>
</div>
