<SidebarWrapper
  @direction='left'
  @title='Sample Pool'
  @onCloseSidebar={{@onCloseSidebar}}
  data-test-sample-pool
  {{did-insert this.load}}
>
  <:info>
    <InfoBox>
      <p class='f6 mb3 mt0'>The sounds this project uses. The pool is shared by all snapshots, so every
        snapshot plays the same samples.</p>
      <p class='f6 mb3 mt0'>Add sounds from the catalog, then use them on a track's sampler slot.</p>
    </InfoBox>
  </:info>
  <:default>
    <div class='flex flex-column sidebar-fill'>
      <div class='pa3 flex items-center justify-between'>
        <span class='f6 light-gray'>{{@project.projectSamples.length}} sample{{unless (eq @project.projectSamples.length 1) 's'}}</span>
        <ButtonPrimary
          @label={{if this.browsing 'Done' 'Add samples'}}
          class='f6'
          data-test-pool-browse
          {{on 'click' this.toggleBrowse}}
        />
      </div>

      {{#if this.browsing}}
        <div class='flex flex-column sidebar-fill' data-test-pool-catalog>
          <FilePicker::Search
            @onSelectFile={{this.addToPool}}
            @audioFileTree={{@audioFileTree}}
          >
            <FilePicker::Selection
              @onSelectItem={{this.onSelectItem}}
              @directoryTree={{@audioFileTree.directoryTree}}
            />
          </FilePicker::Search>
        </div>
      {{else}}
        <ul class='list ma0 pa0 overflow-y-auto sidebar-fill' data-test-pool-list>
          {{#each this.rows key='sample.id' as |row|}}
            <li
              class='ph3 pv2 bb b--dark-gray light-gray'
              data-test-pool-sample
              data-sample-path={{row.sample.path}}
              data-sample-state={{row.state}}
            >
              <div class='flex items-center'>
                <button
                  type='button'
                  class='bn bg-transparent yellow pointer pa1 mr2'
                  aria-label='Preview {{row.sample.label}}'
                  title='Play'
                  {{on 'click' (fn this.preview row.sample)}}
                >▶</button>
                {{#if (eq this.renamingId row.sample.id)}}
                  <input
                    type='text'
                    class='f6 pv1 ph2 grow-1'
                    aria-label='Sample name'
                    value={{row.sample.label}}
                    {{did-insert this.focusInput}}
                    {{on 'keydown' (fn this.onRenameKey row.sample)}}
                    {{on 'blur' (fn this.commitRename row.sample)}}
                  />
                {{else}}
                  <span
                    class='grow-1 truncate fw6'
                    title='{{row.sample.path}} (double-click to rename)'
                    data-test-pool-label
                    {{on 'dblclick' (fn this.startRename row.sample)}}
                  >{{row.sample.label}}</span>
                {{/if}}
                <span class='f7 gray ml2 nowrap' data-test-pool-state>
                  {{#if (eq row.state 'ready')}}{{row.durationText}}{{else if (eq row.state 'error')}}<span class='red' title={{row.audio.error}}>failed</span>{{else if (eq row.state 'loading')}}…{{/if}}
                </span>
                <button
                  type='button'
                  class='bn bg-transparent gray pointer pa1 ml2'
                  aria-label='Remove {{row.sample.label}}'
                  title={{if row.used 'Used by a track: remove it from the track first' 'Remove from the pool'}}
                  disabled={{row.used}}
                  {{on 'click' (fn this.remove row.sample)}}
                >×</button>
              </div>
              <div class='flex items-center flex-wrap f7 gray mt1'>
                <span data-test-pool-usage>
                  {{#if row.used}}Used by {{row.usedByText}}{{else}}Not used{{/if}}
                </span>
                {{#if this.hasSlots}}
                  <span class='ml-auto'>
                    {{#each row.slots as |slot|}}
                      <button
                        type='button'
                        class='f7 ba b--yellow bg-transparent yellow pointer ph2 pv1 ml1'
                        aria-pressed={{if slot.assigned 'true' 'false'}}
                        data-test-pool-use
                        title='Use on slot {{slot.number}} of the selected track'
                        {{on 'click' (fn this.assign row.sample slot.index)}}
                      >{{#if slot.assigned}}✓ {{/if}}Slot {{slot.number}}</button>
                    {{/each}}
                  </span>
                {{/if}}
              </div>
            </li>
          {{else}}
            <li class='pa3 gray f6' data-test-pool-empty>No samples yet. Use "Add samples" to browse the catalog.</li>
          {{/each}}
        </ul>
      {{/if}}
    </div>
  </:default>
</SidebarWrapper>
