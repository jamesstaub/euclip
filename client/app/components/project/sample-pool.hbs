{{! template-lint-disable no-down-event-binding }}
{{! renaming: Enter and Escape on keydown, as in any text field }}
<div class='flex flex-column sidebar-fill' data-test-sample-pool {{did-insert this.load}}>
  <p class='ma0 ph3 pv2 f7 moon-gray' aria-live='polite'>{{this.countText}}</p>
  <ul class='list pl0 ma0 ph2 sidebar-fill scroll-y' aria-label='Sounds in this project' data-test-pool-list>
    {{#each this.rows key='sample.id' as |row|}}
      <li
        class='sound-row flex items-center br2 ph2 f6 light-gray hover-bg-white-10 bl bw1 b--transparent'
        data-test-pool-sample
        data-test-sound-row
        data-sample-path={{row.sample.path}}
        data-sample-state={{row.state}}
        {{draggable-sound row.sample.path}}
      >
        <button
          type='button'
          class='flex-none flex items-center justify-center w2 h2 mr2 pa0 br-100 ba bw1 f7 pointer bg-transparent
            {{if row.playing "b--light-blue light-blue" "b--white-30 light-gray"}}'
          aria-label='{{if row.playing "Stop" "Audition"}} {{row.sample.label}}'
          title='Play'
          data-test-sound-play
          {{on 'click' (fn this.preview row.sample)}}
        >
          {{#if row.playing}}<span class='eq' aria-hidden='true'><i></i><i></i><i></i></span>{{else}}
            {{!-- a drawn triangle, not the ▶ character (whose box sits off-centre in the circle); nudged right by its weight --}}
            <svg class='db' width='10' height='10' viewBox='0 0 10 10' fill='currentColor' aria-hidden='true' data-test-play-icon>
              <path d='M2.6 0.8 L9.2 5 L2.6 9.2 Z' />
            </svg>
          {{/if}}
        </button>
        {{#if (eq this.renamingId row.sample.id)}}
          <input
            type='text'
            class='flex-auto min-w-0 f6 pv1 ph2'
            aria-label='Sample name'
            value={{row.sample.label}}
            {{did-insert this.focusInput}}
            {{on 'keydown' (fn this.onRenameKey row.sample)}}
            {{on 'blur' (fn this.commitRename row.sample)}}
          />
        {{else}}
          <button
            type='button'
            class='no-hover-bg bn bg-transparent pa0 pv2 flex-auto tl light-gray f6 fw6 pointer min-w-0'
            title='{{row.sample.path}} (double-click to rename)'
            data-test-pool-label
            {{on 'dblclick' (fn this.startRename row.sample)}}
          ><span class='truncate db'>{{row.sample.label}}</span></button>
        {{/if}}
        <span class='f7 moon-gray flex-none ml2' data-test-pool-state>
          {{#if (eq row.state 'ready')}}{{row.durationText}}{{else if (eq row.state 'error')}}<span class='red' title={{row.audio.error}}>failed</span>{{else if (eq row.state 'loading')}}…{{/if}}
        </span>
        <Ui::Badge @tone={{if row.used 'accent' 'muted'}} class='flex-none ml2' data-test-pool-usage data-test-sound-badge>{{if row.used (or row.badge row.usedByText) 'not used'}}</Ui::Badge>
        <Ui::Button @variant='solid' @size='s' class='sound-use' data-test-pool-use data-test-sound-use {{on 'click' (fn this.use row.sample)}}>Use <kbd class='o-60'>⏎</kbd></Ui::Button>
        <DropdownMenu
          class='sound-menu flex-none bn bg-transparent pa0 h2'
          aria-label='More about {{row.sample.label}}'
          data-test-pool-menu
          @closeOnSelect={{true}}
          @iconClass='light-fill'
          @items={{row.menu}}
        />
      </li>
    {{else}}
      <li class='pa3 f6 moon-gray' data-test-pool-empty>No sounds yet. Use a sound from <b>All sounds</b> and it is added here.</li>
    {{/each}}
  </ul>
</div>
