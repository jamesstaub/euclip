{{! template-lint-disable no-down-event-binding }}
{{! renaming: Enter and Escape on keydown, as in any text field }}
<div class='flex flex-column sidebar-fill' data-test-sample-pool {{did-insert this.load}}>
  <p class='sound-count' aria-live='polite'>{{this.countText}}</p>
  <ul class='sound-list sound-list--plain sidebar-fill' aria-label='Sounds in this project' data-test-pool-list>
    {{#each this.rows key='sample.id' as |row|}}
      <li
        class='sound-row {{if row.playing "sound-row--playing"}}'
        data-test-pool-sample
        data-test-sound-row
        data-sample-path={{row.sample.path}}
        data-sample-state={{row.state}}
        {{draggable-sound row.sample.path}}
      >
        <button
          type='button'
          class='sound-row__play'
          aria-label='{{if row.playing "Stop" "Audition"}} {{row.sample.label}}'
          title='Play'
          {{on 'click' (fn this.preview row.sample)}}
        >
          {{#if row.playing}}<span class='eq' aria-hidden='true'><i></i><i></i><i></i></span>{{else}}<span aria-hidden='true'>▶</span>{{/if}}
        </button>
        {{#if (eq this.renamingId row.sample.id)}}
          <input
            type='text'
            class='sound-row__rename'
            aria-label='Sample name'
            value={{row.sample.label}}
            {{did-insert this.focusInput}}
            {{on 'keydown' (fn this.onRenameKey row.sample)}}
            {{on 'blur' (fn this.commitRename row.sample)}}
          />
        {{else}}
          <button
            type='button'
            class='sound-row__name'
            title='{{row.sample.path}} (double-click to rename)'
            data-test-pool-label
            {{on 'dblclick' (fn this.startRename row.sample)}}
          ><span class='truncate'>{{row.sample.label}}</span></button>
        {{/if}}
        <span class='sound-row__detail' data-test-pool-state>
          {{#if (eq row.state 'ready')}}{{row.durationText}}{{else if (eq row.state 'error')}}<span class='red' title={{row.audio.error}}>failed</span>{{else if (eq row.state 'loading')}}…{{/if}}
        </span>
        <span class='sound-row__badge {{unless row.used "sound-row__badge--quiet"}}' data-test-pool-usage data-test-sound-badge>{{if row.used (or row.badge row.usedByText) 'not used'}}</span>
        <button type='button' class='sound-row__use' data-test-pool-use data-test-sound-use {{on 'click' (fn this.use row.sample)}}>Use <kbd aria-hidden='true'>⏎</kbd></button>
        <DropdownMenu
          class='sound-row__menu'
          aria-label='More about {{row.sample.label}}'
          data-test-pool-menu
          @closeOnSelect={{true}}
          @iconClass='light-fill'
          @items={{row.menu}}
        />
      </li>
    {{else}}
      <li class='sound-empty' data-test-pool-empty>No sounds yet. Use a sound from <b>All sounds</b> and it is added here.</li>
    {{/each}}
  </ul>
</div>
